json.attendance_structure do
	json.id 															@attendance_structure.try(:id)
	json.name 														@attendance_structure.try(:name)
	json.code 														@attendance_structure.try(:code)
	json.company_id 											@attendance_structure.try(:company_id)
	json.is_active 												@attendance_structure.try(:is_active)
	json.location_id 											@attendance_structure.try(:location_id)
	json.branch_id 												@attendance_structure.try(:branch_id)
	json.department_id 										@attendance_structure.try(:department_id)
	json.grade_id 												@attendance_structure.try(:grade_id)
	json.start_date 											@attendance_structure.try(:start_date)
	json.end_date 												@attendance_structure.try(:end_date)
	json.absent_policy_id 								@attendance_structure.try(:absent_policy_id)
	json.attendance_overtime_id 					@attendance_structure.try(:attendance_overtime_id)
	json.attendance_relaxation_id 				@attendance_structure.try(:attendance_relaxation_id)
	json.early_left_id 										@attendance_structure.try(:early_left_id)
	json.missing_punch_id 								@attendance_structure.try(:missing_punch_id)
	json.description 											@attendance_structure.try(:description)
	json.special_rule 										@attendance_structure.try(:special_rule)
	json.is_flexi 												@attendance_structure.try(:is_flexi)
	json.serve_minutes 										@attendance_structure.try(:serve_minutes)
	json.total_working_minutes						@attendance_structure.try(:total_working_minutes)
	json.addional_minutes									@attendance_structure.try(:addional_minutes)
	json.department_ids 									@attendance_structure.try(:department_ids).split(',').map(&:to_i)
	json.regular_overtime_exception 			@attendance_structure.try(:regular_overtime_exception)
	json.regular_min_salary 							@attendance_structure.try(:regular_min_salary)
	json.regular_max_salary 							@attendance_structure.try(:regular_max_salary)
	json.regular_overtime_id							@attendance_structure.try(:regular_overtime_id)
	json.holiday_overtime_exception 			@attendance_structure.try(:holiday_overtime_exception)
	json.holiday_min_salary 							@attendance_structure.try(:holiday_min_salary)
	json.holiday_max_salary 							@attendance_structure.try(:holiday_max_salary)
	json.holiday_overtime_id 							@attendance_structure.try(:holiday_overtime_id)
	json.is_flexi_in_early_gone						@attendance_structure.try(:is_flexi_in_early_gone)
	json.early_gone_total_working_minute 	@attendance_structure.try(:early_gone_total_working_minute)
end
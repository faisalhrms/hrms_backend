<!DOCTYPE html>
<html>
<head>
  <script>
      function number_pages() {
          var vars={};
          var x=document.location.search.substring(1).split('&');
          for(var i in x) {var z=x[i].split('=',2);vars[z[0]] = decodeURIComponent(z[1]);}
          var x=['frompage','topage','page','webpage','section','subsection','subsubsection'];
          for(var i in x) {
              var y = document.getElementsByClassName(x[i]);
              for(var j=0; j<y.length; ++j) y[j].textContent = vars[x[i]];
          }
      }
  </script>
  <style type="text/css">
    body{
      margin:0;
      font-family: Arial, Helvetica, sans-serif;
    }
    .page-break {
      display: block;
      clear: both;
      page-break-after: always;
    }
    .container:after{
      content: "";
      display: block;
      clear: both;
    }
    table { page-break-inside:auto; border-collapse: collapse; margin: 0px auto;}
    tr    { page-break-inside:avoid; page-break-after:auto }
    thead { display:table-header-group }
    tfoot { display: table-row-group }
  </style>
</head>
<body onload="number_pages()">
<% if @file_name == "advance_deductions" %>
  <div style="width:100%;padding:10px;position:relative;font-family:Lato,sans-serif">
  <table style="width: 85%; margin-left: 7.5%; margin-right: 7.5%;">
    <tr>
      <td style="border: 2px solid #000; text-align: center" rowspan="2">
        <img src="<%= @company.avatar.url %>" width="150" />
      </td>
      <% company_name = @company.name %>
      <% unless params[:location_id].blank? %>
        <% company_name += " (#{Location.find(params[:location_id]).name})" %>
      <% end %>
      <td style="border: 2px solid #000; text-align: center" rowspan="3">
        <p style="font-weight: 800; margin-bottom: 5px; font-size: 14px">Employees Monthly Deductions Report</p>
        <p style="font-weight: 900; margin-bottom: 5px; font-size: 16px; margin-top: 10px"><%= company_name %></p>
        <span style=" margin-bottom: 10px; font-size: 18px;border-bottom: 0.03rem solid black; margin-top: 10px">Advance Agianst Salary Deduction for the Month of: <%= @pay_executions.last.formated_pay_month %></span>
      </td>
      <td style="border: 2px solid #000; text-align: right; padding: 8px 10px">
        <span style="font-weight: 800; font-style: italic;">Print date:</span>
      </td>
      <td style="border: 2px solid #000; padding: 8px 10px">
        <span><%= DateTime.now.strftime("%d/%m/%Y") %></span>
      </td>
    </tr>
    <tr>
      <td style="border: 2px solid #000; text-align: right; padding: 3px 10px">
        <span style="font-weight: 800; font-style: italic;">Print time:</span>
      </td>
      <td style="border: 2px solid #000; padding: 3px 10px">
        <span><%= DateTime.now.strftime("%I:%M:%S") %></span>
      </td>
    </tr>
    <tr>
      <td style="border: 2px solid #000; text-align: center; padding: 5px 0">
        <span style="font-weight: 900"><%= @company.name %></span>
      </td>
      <td style="border: 2px solid #000; text-align: right; padding: 5px 10px">
        <span style="font-weight: 800; font-style: italic;">Page:</span>
      </td>
      <td style="border: 2px solid #000; padding: 5px 10px">
        Page <span class="page"></span> of <span class="topage"></span>
      </td>
    </tr>
  </table>
</div>

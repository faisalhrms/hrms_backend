<% elsif @file_name == "bank_sheet" || @file_name == "worker_bank_sheet" || @file_name == "workers_payment_sheet"%>
  <div style="width:100%;padding:10px;position:relative;">
    <p style="margin: 0 0 5px; text-align: right; font-size: 13px; padding: 0 10px; width: 90%; margin-left: 5%; margin-right: 5%;">
      <span style="margin-right: 30px;"><span style="font-weight: 600; font-style: italic; margin-right: 10px">Print Date:</span> <%=DateTime.now.strftime("%d/%m/%Y") %></span>
      <span><span style="font-weight: 600; font-style: italic; margin-right: 10px">Print Time:</span> <%=DateTime.now.strftime("%I:%M:%S") %></span>
      <span style="font-weight: 900; font-style: italic; margin-right: 10px">Page <span class="page"></span> of <span class="topage"></span></span>
    </p>
    <% grade = "Management, Staff, Worker" %>
    <% if grade_params.present? %>
      <% grade = grade_name(grade_params) %>
    <% end %>
    <% company_name = @pay_execution.company_name.upcase %>
    <% unless params[:location_id].blank? %>
      <% company_name += " (#{Location.find(params[:location_id]).name})" %>
    <% end %>
    <table style="width: 90%; margin-left: 5%; margin-right: 5%;">
      <tr>
        <td style="border: 2px solid #000; text-align: center; width: 175px">
          <img src="<%= @company.avatar.url %>" width="175" />
          <p style="text-align: center; padding: 5px 0; font-weight: 600; font-size: 15px; margin-bottom: 5px">Diamond Fabrics Ltd.</p>
        </td>
        <td style="border: 2px solid #000; text-align: center">
          <p style="font-weight: 600;margin: 10px 0;">Employees Monthly Salary Payment Sheet (<%= params[:payment_method] %>)</p>
          <p style="font-weight: 600; margin: 10px 0;">Report For: <%= company_name %></p>
          <p style="margin: 10px 0; font-size: 13px">Report For: <%= grade %></p>
          <p style="margin: 10px 0; font-size: 13px">For the Month of: <%= @pay_execution.formated_pay_month %></p>

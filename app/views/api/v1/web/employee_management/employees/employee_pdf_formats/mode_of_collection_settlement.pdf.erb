	<body>
		<div style="box-sizing:border-box;position:relative;padding:0px;margin:0px;text-align:left;width: 1050px;border: 2px solid rgba(0, 0, 0, 0.14);">
			<div class="main_heading_block">
				<div class="main_heading_block_img">
					<% if not @employee.company.nil? %>
						<% if not @employee.company.avatar.nil? %>
							<img src=<%=@employee.company.present? ? @employee.company.avatar.url : "" %> width="100px">
						<% end %>
					<% end %>
				</div>
				<div class="main_heading_block_heading">
					<h2><%= @employee.company_name %></h2>
					<p style="font-size: 20px;">Human Resource - Employee Mode of Collection Settlement</p>
				</div>
			</div>
			<div class="main_employee_info_block">
				<div class="main_employee_info_block_info">
					<div class="main_employee_info_block_min">
						<div class="main_employee_info_block_name" >Name:</div>
						<div class="main_employee_info_block_name_text"><%= @employee.present? ? "#{@employee.full_name}" : "" %></div>				
					</div>
					<div class="main_employee_info_block_min">
						<div class="main_employee_info_block_designation">Designation:</div>
						<div class="main_employee_info_block_designation_text"><%= @employee.designation_name %></div>
					</div>
					<div class="main_employee_info_block_min">
						<div class="main_employee_info_block_salary_unit">Salary Unit:</div>
						<div class="main_employee_info_block_salary_unit_text"><%= @employee.salary_unit_name %></div>
					</div>
					<div class="main_employee_info_block_min">
						<div class="main_employee_info_block_department">Department:</div>
						<div class="main_employee_info_block_department_text"><%= @employee.department_name %></div>
					</div>
					<div class="main_employee_info_block_min">
						<div class="main_employee_info_block_card_no">Card No.:</div>
						<div class="main_employee_info_block_card_no_text"><%= @employee.employee_code %></div>
					</div>
					<div class="main_employee_info_block_min">
						<div class="main_employee_info_block_grade">Grade:</div>
						<div class="main_employee_info_block_grade_text"><%= @employee.grade_name %></div>
					</div>
				</div>
				<div class="main_employee_info_block_img">
					<% if not @employee.nil? %>
						<% if not @employee.avatar.nil? %>
							<img src=<%= @employee.avatar.url %> width="150px">
						<% end %>
					<% end %>
				</div>
			</div>
			<div class="hand_over_to_employee">
				<div class="hand_over_to_employee_heading">Please select only one Mode of payment and provide details (if required):</div>
				<div class="hand_over_to_employee_table">
					<div class="hand_over_to_employee_table_element">
						<div class="hand_over_to_employee_table_header_asset_element">Self : </div>
						<div class="hand_over_to_employee_table_header_entitled_element"><div class="hand_over_to_employee_table_header_entitled_element_box"></div></div>
					</div>
				</div>
				<div class="hand_over_to_employee_table">
					<div class="hand_over_to_employee_table_element">
						<div class="hand_over_to_employee_table_header_asset_element">Transfer to Account : </div>
						<div class="hand_over_to_employee_table_header_entitled_element"><div class="hand_over_to_employee_table_header_entitled_element_box"></div></div>
					</div>
					<div class="hand_over_to_employee_table_element">
						<div class="hand_over_to_employee_table_header_asset_element">A/c No : </div>
						<div class="hand_over_to_employee_table_header_entitled_element">___________________________________________________________________________________</div>
					</div>
					<div class="hand_over_to_employee_table_element">
						<div class="hand_over_to_employee_table_header_asset_element">A/c Name : </div>
						<div class="hand_over_to_employee_table_header_entitled_element">___________________________________________________________________________________</div>
					</div>
					<div class="hand_over_to_employee_table_element">
						<div class="hand_over_to_employee_table_header_asset_element">Bank Name : </div>
						<div class="hand_over_to_employee_table_header_entitled_element">___________________________________________________________________________________</div>
					</div>
					<div class="hand_over_to_employee_table_element">
						<div class="hand_over_to_employee_table_header_asset_element">Branch Location : </div>
						<div class="hand_over_to_employee_table_header_entitled_element">___________________________________________________________________________________</div>
					</div>
				</div>
				<div class="hand_over_to_employee_table">
					<div class="hand_over_to_employee_table_element">
						<div class="hand_over_to_employee_table_header_asset_element">Cheque to be received by colleague : </div>
						<div class="hand_over_to_employee_table_header_entitled_element"><div class="hand_over_to_employee_table_header_entitled_element_box"></div></div>
					</div>
					<div class="hand_over_to_employee_table_element">
						<div class="hand_over_to_employee_table_header_asset_element">Name : </div>
						<div class="hand_over_to_employee_table_header_entitled_element">___________________________________________________________________________________</div>
					</div>
					<div class="hand_over_to_employee_table_element">
						<div class="hand_over_to_employee_table_header_asset_element">Grade : </div>
						<div class="hand_over_to_employee_table_header_entitled_element">___________________________________________________________________________________</div>
					</div>
					<div class="hand_over_to_employee_table_element">
						<div class="hand_over_to_employee_table_header_asset_element">Designation : </div>
						<div class="hand_over_to_employee_table_header_entitled_element">___________________________________________________________________________________</div>
					</div>
					<div class="hand_over_to_employee_table_element">
						<div class="hand_over_to_employee_table_header_asset_element">Department : </div>
						<div class="hand_over_to_employee_table_header_entitled_element">___________________________________________________________________________________</div>
					</div>
					<div class="hand_over_to_employee_table_element">
						<div class="hand_over_to_employee_table_header_asset_element">Location : </div>
						<div class="hand_over_to_employee_table_header_entitled_element">___________________________________________________________________________________</div>
					</div>
				</div>
				<div class="hand_over_to_employee_table">
					<div class="hand_over_to_employee_table_element">
						<div class="hand_over_to_employee_table_header_asset_element">Cheque to be received by family member : </div>
						<div class="hand_over_to_employee_table_header_entitled_element"><div class="hand_over_to_employee_table_header_entitled_element_box"></div></div>
					</div>
					<div class="hand_over_to_employee_table_element">
						<div class="hand_over_to_employee_table_header_asset_element">Name : </div>
						<div class="hand_over_to_employee_table_header_entitled_element">___________________________________________________________________________________</div>
					</div>
					<div class="hand_over_to_employee_table_element">
						<div class="hand_over_to_employee_table_header_asset_element">Relation : </div>
						<div class="hand_over_to_employee_table_header_entitled_element">___________________________________________________________________________________</div>
					</div>
					<div class="hand_over_to_employee_table_element">
						<div class="hand_over_to_employee_table_header_asset_element">CNIC No : </div>
						<div class="hand_over_to_employee_table_header_entitled_element">___________________________________________________________________________________</div>
					</div>
				</div>
				<div class="container" style="margin-top:30px">
					<div style="float:left;left:30%;">
						<p style="margin-top:20px;margin-bottom:5px;font-size:16px;"><b>Name:</b> _____________________________________</p>
						<p style="margin-top:30px;margin-bottom:5px;font-size:16px;"><b>Date:</b> _____________________________________</p>
					</div>
				</div>
				<div class="container" style="margin-top:30px">
					<div style="float:right;width:30%;">
						<p style="margin-top:20px;margin-bottom:5px;font-size:11px;">SIGNATURE</p>
						<div style="border:2px solid #ececec;height: 50px;"></div>
					</div>
				</div>
			</div>
		</div>
	</body>
</html>
<!doctype html>
<html>
	<head>
		<meta charset="utf-8">
    <title>Activity Stream</title>
    <style>
    body {
      font-family: sans-serif;
    }
    
    .table {
      width: 100%;
      max-width: 100%;
      border: 1px solid black;
      border-collapse: collapse;
    }
    
    .table-header > td {
      background-color: #CCCCCC;
      color: #222222!important;
      font-weight: bolder;
      font-size: 11px;
      border: 1px solid #BDB8B8;
      border-collapse: collapse;
      padding: 3px;
    }
    
    .table-row > td {
      border: 1px solid #BDB8B8;
      padding: 3px;
      border-collapse: collapse;
      color: #666666;
    }
    
    .pl-20 {
      padding-left: 20px;
    }
    
    .text-center {
      text-align: center;
    }
    
    .sr-number {
      width: 20px;
    }
    
    .text-xs {
      font-size: 9px;
    }
    
    .text-sm {
      font-size: 13px;
    }
    
    .text-md {
      font-size: 16px;
    }
    
    .clr-blue {
      color: #5BC0DE;
    }
    
    .clr-green {
      color: #5CB85C;
    }
    
    .fw-bold {
      font-weight: bold;
    }
    
    .clr-lite-gray {
      color: #222222;
    }
    
    .mb-5 {
      margin-bottom: 5px;
    }
    
    .clear {
      clear: both;
    }
    table, tr, td, th, tbody, thead, tfoot {
        page-break-inside: avoid !important;
    }
    </style>
  </head>
  ​
  <body>
    <div class="mb-5">
    	<div class="mb-5">
      <p class="clr-blue text-sm fw-bold" style="text-align:  center;">Activity Stream Report:</p>
      <p class="clr-green text-sm fw-bold" style="text-align:  center;">Export Date: <%= params[:start_date].to_date.strftime('%d/%m/%Y')%>  <%= "-" %>  <%= params[:end_date].to_date.strftime('%d/%m/%Y') %></p>
			</div>
    </div>
    <table class="table text-xs clear">
      <tr class="table-header">
        <td class="sr-number">Sr#</td>
        <td>Name</td>
        <td>Email</td>
        <td>Role</td>
        <td>Action Perform</td>
        <td>IP Address</td>
        <td>Action Time</td>
      </tr>
      <% count = 0 %>
      <% @user_activities.each do |user_activity| %>
        <% count = count + 1 %>        
        <tr class="table-row">
          <td> <%= count %> </td>
          <td> <%= user_activity.full_name %> </td>
          <td> <%= user_activity.email %> </td>
          <td> <%= user_activity.role_name %> </td>
          <td> <%= user_activity.action_performed %> </td>
          <td> <%= user_activity.ip_address %> </td>
          <td> <%= user_activity.created_at.localtime.strftime('%d/%m/%Y %I:%M:%S %p') %> </td>
        </tr>
      <% end %>
      <% if count == 0 %>
        <tr class="table-row">
          <td class="text-center" colspan="8"> No Record </td>
        </tr>
      <% end %>
    </table>
  </body>
</html>
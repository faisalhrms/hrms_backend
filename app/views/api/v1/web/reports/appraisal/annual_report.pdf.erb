<div>
  <table width="100%">
    <tr style="text-align: center; font-size: 18px">
      <th>ANNUAL PERFORMANCE APPRAISAL FORM</th>
    </tr>
    <tr style="text-align: center; font-size: 15px">
      <td>(To be used by the Line Manager for scoring in Sections 1 and 3)</td>
    </tr>
  </table>
</div><br>
<div>
  <table width="100%">
    <tr style="padding: 10px; font-weight: bolder">
      <td style="width: 30%">Rating Scale</td>
      <td style="width: 40%">Rating Description</td>
      <td style="width: 30%">Performance % Against Stated Goal and Objectives</td>
    </tr>
    <tr>
      <td>5 = Outstanding (OS)</td>
      <td>Exceeds Annual Targets/Objectives Consistently </td>
      <td>Above 125%</td>
    </tr>
    <tr>
      <td>4 = Exceeds Expectations (EE)</td>
      <td>Exceeds Annual Targets/Objectives Occasionally</td>
      <td>Between 101% and 125%</td>
    </tr>
    <tr>
      <td>3 = Meets Expectations (ME)</td>
      <td>Meets Annual Targets/Objectives Consistently</td>
      <td>Between 95% and 100%</td>
    </tr>
    <tr>
      <td>2 = Partially Meet Expectations (PME)</td>
      <td>Meets Annual Targets/Objectives Occasionally</td>
      <td>Between 75%and 94%</td>
    </tr>
    <tr>
      <td>1 = Unsatisfactory (US)</td>
      <td>Does not meet Annual Targets/Objectives</td>
      <td>Below 75%</td>
    </tr>
  </table>
</div><br>
<div>
  <table width="100%">
    <tr style="text-align: center; font-size: 18px">
      <th>APPRAISAL SCORES</th>
    </tr>
    <tr style="text-align: center; font-size: 15px">
      <td>Please fill-in the Appraisal Scores of Section 1 and 2 here</td>
    </tr>
  </table>
</div><br>
<div>
  <table width="100%">
    <tr style="padding: 5px">
      <td style="width: 30%">Section - 1 </td>
      <td style="width: 40%">Score in Business Objectives</td>
      <td style="width: 30%">2.41</td>
    </tr>
    <tr>
      <td>Section - 2</td>
      <td>Score in Core Competencies </td>
      <td><%= @employee_id.first.net_score %></td>
    </tr>
    <tr>
      <td colspan="2">Total Scores of Section 1 and Section 2</td>
      <td>3.69 </td>
    </tr>
  </table>
</div><br>
</body>
</html>
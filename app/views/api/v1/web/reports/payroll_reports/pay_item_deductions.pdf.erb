<!DOCTYPE html>
<html>
<head>
  <meta http-equiv="content-type" content="text/html; charset=utf-8" />
  <title> Pay Item Report </title>
  <style type="text/css">
      body{
          margin:0;
          font-family: Arial, Helvetica, sans-serif;
      }
      .page-break {
          display: block;
          clear: both;
          page-break-after: always;
      }
      .container:after{
          content: "";
          display: block;
          clear: both;
      }
      table { page-break-inside:auto; border-collapse: collapse; margin: 0px auto;}
      tr    { page-break-inside:avoid; page-break-after:auto }
      thead { display:table-header-group }
      tfoot { display: table-row-group }
  </style>
</head>

<body>
<div style="width:100%;padding:10px;position:relative;font-family:Lato,sans-serif">
  <table style="width: 85%; margin-left: 7.5%; margin-right: 7.5%; margin-top: 14px">
    <thead style="text-align: left">
    <tr style="border: 2px solid #000;">
      <th style="padding: 6px 10px">Sr. No</th>
      <th style="padding: 6px 10px; text-align: center; width: 150px;">Employee ID</th>
      <th style="padding: 6px 10px">Employee's Name</th>
      <th style="padding: 6px 10px">Designation</th>
      <% @pay_items.each do |pay_item| %>
        <th style="padding: 6px 10px; text-align: center"><%= " #{pay_item.name} (Rs.)" %> </th>
      <% end %>
    </tr>
    </thead>
    <% count = 0 %>
    <% grand_total = {} %>
    <% total_employees = 1 %>
    <% pay_item_details = {} %>
    <% pay_details = PayInvoiceDetail.where(pay_invoice_id: @pay_invoices.ids, item_id: @pay_items).pluck(:pay_invoice_id, :item_id, :amount) %>
    <% pay_details.each do |pay_detail| %>
      <% if pay_item_details[pay_detail[0]].nil? %>
        <% pay_item_details[pay_detail[0]] = {} %>
      <% end %>
      <% pay_item_details[pay_detail[0]][pay_detail[1]] = pay_detail[2] %>
    <% end %>
    <tbody style="">
    <% @pay_invoices.each do |pay_invoice| %>
      <% count = count + 1 %>
      <% if count == 1 %>
        <tr style="border-bottom: 2px solid #000">
          <td style="font-weight: 600; padding-top: 15px; padding-left: 10px; width: 115px">Report For:</td>
          <% grade = "ALL" %>
          <% grade = grade_name(grade_params) if grade_params.present?%>
          <td style="font-weight: 600; padding-top: 15px; text-align: center"><span style="display: inline-block;padding: 8px 10px; width: 100%; background-color: #bbb; width: 150px;"><%= grade %></span></td>
        </tr>
      <% end %>
      <% if pay_item_details[pay_invoice.id].values.sum != 0 %>
        <tr style="border-bottom: 1px solid #000">
          <td style="padding: 10px; text-align: center"> <%= total_employees %> </td>
          <td style="padding: 10px; text-align: center"> <%= pay_invoice.employee.employee_code %> </td>
          <td style="padding: 10px"> <%= pay_invoice.employee.full_name %> </td>
          <td style="padding: 10px"> <%= pay_invoice.employee.designation_name %> </td>
          <% @pay_items.each do |pay_item| %>
            <td style="padding: 10px; font-family:Courier; font-size: 17px; font-weight: 600; text-align: center"> <%= number_with_precision(pay_item_details[pay_invoice.id][pay_item.id], :precision => 2, :delimiter => ',') %> </td>
            <% grand_total[pay_item.id] = grand_total[pay_item.id].to_f + pay_item_details[pay_invoice.id][pay_item.id] %>
          <% end %>
          <% total_employees += 1 %>
        </tr>
      <% end %>
    <% end %>
    <tr style="border-bottom: 1px solid #000">
      <td style="padding: 10px; font-family:Courier; font-size: 17px; font-weight: 600; text-align: center">Grand Total</td>
      <td colspan="3"></td>
      <% grand_total.values.each do |data| %>
        <td style="padding: 10px; font-family:Courier; font-size: 17px; font-weight: 600; text-align: center"><%= data %></td>
      <% end %>
    </tr>
    </tbody>
  </table>
</div>
</body>
</html>
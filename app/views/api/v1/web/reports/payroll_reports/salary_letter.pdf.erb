                <td style="padding:6px 6px 6px 25px;text-align:center;"> - </td>
                <td style="padding:6px 6px 6px 25px;text-align:center;"> - </td>
                <td style="padding:6px 6px 6px 25px;text-align:center;"> TOTAL </td>
                <td style="padding:6px 6px 6px 25px;text-align:center;"><%= number_with_precision(total_net_amount.to_f.round, :precision => 2, :delimiter => ',') %></td>
              </tr>
            </tbody>
          </table>
          <div class="container">
            <div style="float:left;width:30%;">
              <p style="margin-bottom:5px;font-size:13px;text-transform:uppercase;margin-top:5px;color:#444; text-align: right"><%= "For #{@company.name} - #{salary_unit.name}" %></p>
              <div style="border:2px solid #ececec;height: 50px;"></div>
               <p style="font-size:13px;text-transform:uppercase;margin-top:5px;color:#444; text-align: right">Director </p>
            </div>
          </div>
        </div> 
        <br>
        <br>
        <div class="page-break"></div>
      <% end %>
    <% end%>
  </body>
</html>

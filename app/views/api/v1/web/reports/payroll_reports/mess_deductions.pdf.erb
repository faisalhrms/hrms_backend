<!DOCTYPE html>
<html>
<head>
  <meta http-equiv="content-type" content="text/html; charset=utf-8" />
  <title>Mess Deduction</title>
  <style type="text/css">
    body{
      margin:0;
      font-family: Arial, Helvetica, sans-serif;
    }
    .page-break {
      display: block;
      clear: both;
      page-break-after: always;
    }
    .container:after{
      content: "";
      display: block;
      clear: both;
    }
    table { page-break-inside:auto; border-collapse: collapse; margin: 0px auto;}
    tr    { page-break-inside:avoid; page-break-after:auto }
    thead { display:table-header-group }
    tfoot { display: table-row-group }
  </style>
</head>

<body>
<div style="width:100%;padding:10px;position:relative;font-family:Lato,sans-serif">
  <table style="width: 85%; margin-left: 7.5%; margin-right: 7.5%; margin-top: 14px">
    <thead style="text-align: left">
    <tr style="border: 2px solid #000;">
      <th style="padding: 6px 10px">Sr. No</th>
      <th style="padding: 6px 10px; text-align: center; width: 150px;">Employee ID</th>
      <th style="padding: 6px 10px">Employee's Name</th>
      <th style="padding: 6px 10px">Designation</th>
      <th style="padding: 6px 10px; text-align: center">Mess Deduction (Rs.)</th>
    </tr>
    </thead>
    <% total_mess = 0 %>
    <% count = 0 %>
    <% total_employees = 1 %>
    <% @pay_invoices.each do |pay_invoice| %>
      <% count = count + 1 %>
      <% mess = pay_invoice.pay_invoice_details.where(:item_name => "Mess Deduction").sum(:amount).round(2) %>
      <% total_mess += mess %>
      <tbody style="">
      <% if count == 1 %>
        <tr style="border-bottom: 2px solid #000">
          <td style="font-weight: 600; padding-top: 15px; padding-left: 10px; width: 115px">Report For:</td>
          <% grade = "ALL" %>
          <% grade = grade_name(grade_params) if grade_params.present?%>
          <td style="font-weight: 600; padding-top: 15px; text-align: center"><span style="display: inline-block;padding: 8px 10px; width: 100%; background-color: #bbb; width: 150px;"><%= grade %></span></td>
          <td colspan="3"></td>
        </tr>
      <% end %>
      <% if mess > 0 %>
        <tr style="border-bottom: 1px solid #000">
          <td style="padding: 10px; text-align: center"> <%= total_employees %> </td>
          <td style="padding: 10px; text-align: center"> <%= pay_invoice.employee.employee_code %> </td>
          <td style="padding: 10px"> <%= pay_invoice.employee.full_name %> </td>
          <td style="padding: 10px"> <%= pay_invoice.employee.designation_name %> </td>
          <td style="padding: 10px; font-family:Courier; font-size: 17px; font-weight: 600; text-align: center"> <%= number_with_precision(mess, :precision => 2, :delimiter => ',') %> </td>
          <% total_employees += 1 %>
        </tr>
      <% end %>
      </tbody>
    <% end %>
    <tfoot>
    <tr>
      <td colspan="3"></td>
      <td style="text-align: right; font-weight: 900; font-style: italic; padding-top: 10px">Total:</td>
      <td style="padding-top: 10px; text-align: center">
        <span style="display: inline-block; border-top: 2px solid #000;border-bottom: 3px solid #000; padding: 6px 50px"><%= number_with_precision(total_mess, :precision => 2, :delimiter => ',') %></span>
      </td>
    </tr>
    </tfoot>
  </table>
</div>
</body>

</html>
<!DOCTYPE html>
<html>
<head>
  <meta http-equiv="content-type" content="text/html; charset=utf-8" />
  <title>Salary Letter</title>
  <link rel="stylesheet" media="screen" href="http://s3.amazonaws.com/sapphire-hrms/jameelkhushkhati-ttf" type="text/css"/>
  <style type="text/css">
      .page-break {
          display: block;
          clear: both;
          page-break-after: always;
      }
  </style>
</head>
<body>
<% @salary_units.each do |salary_unit| %>
  <div style="width:1100px;padding:20px;box-sizing:border-box;position:relative;">
    <% count = 1 %>
    <% if not (@company.avatar_file_name.nil? or @company.avatar_file_name.blank?) %>
      <img src=<%= @company.avatar.url %> style="width:150px;height:100px;position:absolute;">
    <% end %>
    <div style="height:80px;margin-top:40px;">
    </div>
    <div style="text-align:right;position:absolute;top:40px;right:20px">
      <p style="font-size:14px;margin:0;"><%= "#{@company.name} - #{salary_unit.name}" %></p>
      <p style="font-size:14px;margin:0;">Phone: <%= salary_unit.description %> Address: <%= @company.address %></p>
    </div>
    <% total_net_amount = 0 %>
    <% @pay_invoices.where(:salary_unit_id => salary_unit.id).order('id ASC').each do |pay_invoice| %>
      <% if @letter_type == 'Salary' %>
        <% diff_amount = pay_invoice.actual_salary - (pay_invoice.pay_invoice_details.where(:item_name => ["Basic Salary", "House Rent", "Medical", "Utility Allowance"]).sum(:amount)).to_f.round %>
        <% net_amount = (pay_invoice.pay_invoice_details.where(:item_name => "Basic Salary").sum(:amount).round + pay_invoice.pay_invoice_details.where(:item_name => "House Rent").sum(:amount).round + pay_invoice.pay_invoice_details.where(:item_name => "Utility Allowance").sum(:amount).round + pay_invoice.pay_invoice_details.where(:item_name => "Medical").sum(:amount).round + pay_invoice.pay_invoice_details.where(:item_name => "Medical Allowance (OPD)").sum(:amount).round + pay_invoice.pay_invoice_details.where(:item_name => ["Other Allowance", "Bike Fuel Allowance"]).sum(:amount).round + pay_invoice.pay_invoice_details.where(:item_name => ["Incentive"]).sum(:amount).round + pay_invoice.pay_invoice_details.where(:item_name => ["Leave Encashment Arrears"]).sum(:amount).round + pay_invoice.pay_invoice_details.where(:item_name => "Fuel Allowance").sum(:amount).round + pay_invoice.pay_invoice_details.where(:item_name => "Increment Arrears").sum(:amount).round + pay_invoice.pay_invoice_details.where(:item_name => ["Manual Arrear", "Allowance Arrear", "Deduction Reimbursement Arrear", "Salary Arrears", "Arrears", "Over Time", "Off Day Payment"]).sum(:amount).round + diff_amount) - (pay_invoice.pay_invoice_details.where(:item_name => ["LWP", "Attendance Deduction"]).sum(:amount).round + pay_invoice.monthly_tax + pay_invoice.pay_invoice_details.where(:item_name => "Advance").sum(:amount).round + pay_invoice.pay_invoice_details.where(:item_name => "Loan").sum(:amount).round + pay_invoice.pay_invoice_details.where(:item_name => "Provident Fund").sum(:amount).round + pay_invoice.pay_invoice_details.where(:item_name => "Arrears Provident Fund").sum(:amount).to_f.round + pay_invoice.pay_invoice_details.where(:item_name => "EOBI").sum(:amount).round + pay_invoice.pay_invoice_details.where(:item_name => "EOBI Deduction").sum(:amount).round + pay_invoice.pay_invoice_details.where(:item_name => ["Salary Deduction", "Allowance Deduction", "Other Deduction"]).sum(:amount).round + pay_invoice.pay_invoice_details.where(:item_name => "Bike Loan").sum(:amount).round + pay_invoice.pay_invoice_details.where(:item_name => "Mess Deduction").sum(:amount).round + pay_invoice.pay_invoice_details.insurance_premium_gli) %>
      <% else %>
        <% net_amount = (pay_invoice.pay_invoice_details.where(:item_name => @letter_type).sum(:amount).to_f.round) %>
      <% end %>
      <% total_net_amount = total_net_amount + net_amount.to_f.round %>
    <% end %>
    <div class="container" style="margin-top: 60px">
      <div style="float:left;">
        <p style="font-size:12px;margin-top:0px;">The Manager</p>
        <p style="font-size:12px;margin-top:0px;">Habib Metropolitan Bank Limited,</p>
        <p style="font-size:12px;margin-top:0px;">Main Branch, Lahore.</p>
        <p style="font-size:12px;margin-top:0px;">Dear Sir,</p>
        <p style="font-size:12px;margin-top:0px;">Please find enclosed herewith cheque No. <%= params[:check_number]%> Dated <%= params[:selected_date].to_date.strftime("%d/%m/%Y") %> Favoring The Manager Habib Metropolitan Bank Limited, Main Branch, Lahore for Rs. <%= number_with_precision(total_net_amount, :precision => 0, :delimiter => ',') %> (<%= total_net_amount.humanize.titleize.gsub(',', '') %> Only) with request to please transfer the unders mentioned amounts in the account numbers given their against with your branch.</p>
      </div>
    </div>
    <table style="border-collapse:collapse;width:100%;table-layout:fixed;">
      <thead>
      <tr style="background-color:#4a4a4a;color:#fff;border:1px solid #4a4a4a;border-bottom:0px;">
        <th style="width:5%;text-align:center;text-transform:uppercase;font-weight:300;font-size:12px;padding:6px 6px 6px 25px;">
          S/No.
        </th>
        <th style="width:30%;text-align:center;text-transform:uppercase;font-weight:300;font-size:12px;padding:6px">
          Name
        </th>
        <th style="width:30%;text-align:center;text-transform:uppercase;font-weight:300;font-size:12px;padding:6px;">
          A/C No
        </th>
        <th style="width:15%;text-align:center;text-transform:uppercase;font-weight:300;font-size:12px;padding:6px;">
          Branch
        </th>
        <th style="width:20%;text-align:center;text-transform:uppercase;font-weight:300;font-size:12px;padding:6px">
          Amount
        </th>
      </tr>
      </thead>
      <tbody style="font-size:13px">
      <% @pay_invoices.where(:salary_unit_id => salary_unit.id).order('id ASC').each do |pay_invoice| %>
        <% if @letter_type == 'Salary' %>
          <% diff_amount = pay_invoice.actual_salary - (pay_invoice.pay_invoice_details.where(:item_name => ["Basic Salary", "House Rent", "Medical", "Utility Allowance"]).sum(:amount)).to_f.round %>
          <% net_amount = (pay_invoice.pay_invoice_details.where(:item_name => "Basic Salary").sum(:amount).round + pay_invoice.pay_invoice_details.where(:item_name => "House Rent").sum(:amount).round + pay_invoice.pay_invoice_details.where(:item_name => "Utility Allowance").sum(:amount).round + pay_invoice.pay_invoice_details.where(:item_name => "Medical").sum(:amount).round + pay_invoice.pay_invoice_details.where(:item_name => "Medical Allowance (OPD)").sum(:amount).round + pay_invoice.pay_invoice_details.where(:item_name => ["Other Allowance", "Bike Fuel Allowance"]).sum(:amount).round + pay_invoice.pay_invoice_details.where(:item_name => ["Incentive"]).sum(:amount).round + pay_invoice.pay_invoice_details.where(:item_name => ["Leave Encashment Arrears"]).sum(:amount).round + pay_invoice.pay_invoice_details.where(:item_name => "Fuel Allowance").sum(:amount).round + pay_invoice.pay_invoice_details.where(:item_name => "Increment Arrears").sum(:amount).round + pay_invoice.pay_invoice_details.where(:item_name => ["Manual Arrear", "Allowance Arrear", "Deduction Reimbursement Arrear", "Salary Arrears", "Arrears", "Over Time", "Off Day Payment"]).sum(:amount).round + diff_amount) - (pay_invoice.pay_invoice_details.where(:item_name => ["LWP", "Attendance Deduction"]).sum(:amount).round + pay_invoice.monthly_tax + pay_invoice.pay_invoice_details.where(:item_name => "Advance").sum(:amount).round + pay_invoice.pay_invoice_details.where(:item_name => "Loan").sum(:amount).round + pay_invoice.pay_invoice_details.where(:item_name => "Provident Fund").sum(:amount).round + pay_invoice.pay_invoice_details.where(:item_name => "Arrears Provident Fund").sum(:amount).to_f.round + pay_invoice.pay_invoice_details.where(:item_name => "EOBI").sum(:amount).round + pay_invoice.pay_invoice_details.where(:item_name => "EOBI Deduction").sum(:amount).round + pay_invoice.pay_invoice_details.where(:item_name => ["Salary Deduction", "Allowance Deduction", "Other Deduction"]).sum(:amount).round + pay_invoice.pay_invoice_details.where(:item_name => "Bike Loan").sum(:amount).round + pay_invoice.pay_invoice_details.where(:item_name => "Mess Deduction").sum(:amount).round + pay_invoice.pay_invoice_details.insurance_premium_gli) %>
        <% else %>
          <% net_amount = (pay_invoice.pay_invoice_details.where(:item_name => @letter_type).sum(:amount).to_f.round) %>
        <% end %>
        <% if not net_amount.to_i == 0 %>
          <tr style="border:2px solid #ececec;border-top:0px;page-break-inside: avoid;">
            <td style="padding:6px 6px 6px 25px;text-align:center;"><%= count %></td>
            <td style="padding:6px 6px 6px 25px;text-align:center;"><%= pay_invoice.employee.full_name %></td>
            <% if params[:payment_method] == "Bank" %>
              <td style="padding:6px 6px 6px 25px;text-align:center;"><%= pay_invoice.employee.bank_account_number %></td>
            <% else %>
              <td style="padding:6px 6px 6px 25px;text-align:center;"><%= pay_invoice.employee.payment_method %></td>
            <% end %>
            <td style="padding:6px 6px 6px 25px;text-align:center;"><%= pay_invoice.employee.bank_branch_name %></td>
            <td style="padding:6px 6px 6px 25px;text-align:center;"><%= number_with_precision(net_amount.to_f.round, :precision => 0, :delimiter => ',') %></td>
          </tr>
        <% end %>
        <% count = count + 1 %>
      <% end %>
      <tr style="border:2px solid #ececec;border-top:0px;page-break-inside: avoid;">
        <td style="padding:6px 6px 6px 25px;text-align:center;"> - </td>
        <td style="padding:6px 6px 6px 25px;text-align:center;"> - </td>
        <td style="padding:6px 6px 6px 25px;text-align:center;"> - </td>
        <td style="padding:6px 6px 6px 25px;text-align:center;"> TOTAL </td>
        <td style="padding:6px 6px 6px 25px;text-align:center;"><%= number_with_precision(total_net_amount.to_f.round, :precision => 0, :delimiter => ',') %></td>
      </tr>
      </tbody>
    </table>
    <div class="container">
      <div style="float:left;width:30%;">
        <p style="margin-bottom:5px;font-size:13px;text-transform:uppercase;margin-top:5px;color:#444; text-align: right"><%= "For #{@company.name} - #{salary_unit.name}" %></p>
        <div style="border:2px solid #ececec;height: 50px;color: gray">Director</div>
      </div>
    </div>
  </div>
  <div class="page-break"></div>
<% end %>
</body>
</html>
<style type="text/css">
    @font-face{
        font-family: Lato;
        -fs-pdf-font-embed: embed;
        -fs-pdf-font-encoding: Identity-H;
    }
    *{
        box-sizing: border-box;
    }
    body{
        margin:0;
        font-family: Lato, sans-serif;
    }
    .container:after{
        content:"";
        display: block;
        clear: both;
    }
    .checkbox{
        height: 14px;
        width: 14px;
        border: 2px solid #000;
        margin: 0 auto;
    }
</style>
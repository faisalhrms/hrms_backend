<!DOCTYPE html>
<html>
<head>
  <title>Eid Reward 1</title>
  <style type="text/css">
    .page-break {
      display: block;
      clear: both;
      page-break-after: always;
    }
    .container:after{
      content: "";
      display: block;
      clear: both;
    }
    table { page-break-inside:auto }
    tr    { page-break-inside:avoid; page-break-after:auto }
    thead { display:table-header-group }
    tfoot { display:table-footer-group }
  </style>
</head>

<body>
<div style="text-align:right;font-size:10px">
  <%= "Extraction Date - #{DateTime.now.strftime("%B %d, %Y %I:%M %P")} "%>
</div>
<%# Setting for Bonus %>
<%#  **************************** %>
<% pay_month = params[:pay_month].to_date.strftime("%B %Y") %>
<% basic_salary_month = params[:pay_month].to_date.strftime("%B %Y") %>
<% bonus_item_name = 'Eid Reward 2' %>
<%#  **************************** %>
<div style="width:1970px;padding:20px;box-sizing:border-box;position:relative;font-family:Lato,sans-serif">
  <% if not (@company.avatar_file_name.nil? or @company.avatar_file_name.blank?) %>
    <img src=<%= @company.avatar.url %> style="width:200px;height:75px;position:absolute">
  <% end %>
  <div style="height:60px;margin-top:40px;">
    <% if @salary_unit_name == "SDL" %>
      <h1 style="text-align:center;font-size:16.6666667px;font-weight:300;margin-bottom:0px;">Sapphire Dairies Pvt Ltd</h1>
    <% else %>
      <h1 style="text-align:center;text-transform:uppercase;font-size:16.6666667px;font-weight:300;margin-bottom:0px;"><%= @company.name %></h1>
    <% end %>
    <h1 style="text-align:center;text-transform:uppercase;font-size:14px;font-weight:300;margin-bottom:0px;">EMPLOYEE BONUS REGISTER REPORT</h1>
    <h2 style="text-align:center;text-transform:uppercase;font-size:12px;font-weight:300;margin-bottom:0px;">
      <% if not @salary_unit_name.blank? %>
        <%= @salary_unit_name %>
      <% end %>
    </h2>
    <h2 style="text-align:center;text-transform:uppercase;font-size:12px;font-weight:300;margin-bottom:0px;"><%= params[:pay_month].to_date.strftime("%B %Y") %></h2>
  </div>
  <% if params[:manual_register] == "true" %>
    <% selling_departments  = Department.where(:name => ['Marketing', 'Export', 'Marketing&Export', 'Supply Chain']) %>
    <% admin_departments    = Department.where.not(:name => ['Marketing', 'Export', 'Marketing&Export', 'Supply Chain']) %>
    <% admin_data           = @pay_invoices.where(pay_month: pay_month, :department_id => admin_departments.collect(&:id)).order('employee_id ASC') %>
    <% selling_data         = @pay_invoices.where(pay_month: pay_month, :department_id => selling_departments.collect(&:id)).order('employee_id ASC') %>
    <% basic_salaries = PayInvoice.where( :status => true, :pay_month => basic_salary_month).group(:employee_id, :actual_salary).count.keys.to_h %>
    <% count = 1 %>
    <% grand_earning, grand_bonus = 0, 0 %>
    <% { administration: admin_data, selling: selling_data}.each do |name, data| %>
      <h3><%= name.to_s.titleize %></h3>
      <table class="main-table" style="width:100%;margin-top:20px;border-collapse:collapse">
        <thead style="text-align:center;font-size: 10px;">
        <tr style="background-color:#4a4a4a;border:2px solid #4a4a4a;border-bottom:0px;">
          <th>SR NO.</th>
          <th>Emp Code</th>
          <th>Name</th>
          <th>Designation</th>
          <th>Date of Joining</th>
          <th>Basic Salary</th>
          <th style="color: white">Bonus</th>
        </tr>
        </thead>
        <tbody style="text-align:center;font-size:10px">
        <% data.each do |pay_invoice| %>
          <tr style="border:2px solid #ececec;border-top:0px">
            <td><%= count %></td>
            <td> <%= pay_invoice.employee_code %> </td>
            <td> <%= pay_invoice.employee_name %> </td>
            <td> <%= pay_invoice.designation_name %> </td>
            <td> <%= ReportFormat.date_format(pay_invoice.joining_date) %> </td>
            <td> <%= number_with_precision((basic_salaries[pay_invoice.employee_id].to_i * 0.67), :precision => 0, :delimiter => ',') %> </td>
            <% annual_bonus_sum = pay_invoice.pay_invoice_details.where(:item_name => bonus_item_name).sum(:amount).to_f.round %>
            <% if pay_invoice.employee_code == "870006" %>
              <td>4188</td>
            <% elsif pay_invoice.employee_code == "870030" %>
              <td>161917</td>
            <% elsif pay_invoice.employee_code == "870012" %>
              <td>33500</td>
            <% else %>
              <td> <%= number_with_precision((annual_bonus_sum), :precision => 0, :delimiter => ',') %> </td>
            <% end %>
            <% count = count + 1 %>
          </tr>
        <% end %>

        <% column_no_6 = 0 %>
        <% column_no_7 = 0 %>

        <% data.each do |pay_invoice| %>
          <% bonus_sum = pay_invoice.pay_invoice_details.where(:item_name => bonus_item_name).sum(:amount).to_f.round %>
          <% column_no_6 += basic_salaries[pay_invoice.employee_id].to_i * 0.67 %>
          <% column_no_7 += bonus_sum %>
        <% end %>
        <tr style="border:2px solid #ececec;border-top:0px">
          <td> Sub Total </td>
          <% 4.times do %>
            <td> <%= "" %> </td>
          <% end %>
          <% [column_no_6, column_no_7].each do |column| %>
            <td> <%= number_with_precision(column.to_f.round, :precision => 0, :delimiter => ',') %> </td>
          <% end %>
          <% grand_bonus += column_no_7 %>
          <% grand_earning += column_no_6 %>
        </tr>
        </tbody>
      </table>
    <% end %>
    <div>
      <h3> Grand Earning: <%= number_with_precision(grand_earning, :precision => 0, :delimiter => ',') %></h3>
      <h3> Grand Bonus: &nbsp;&nbsp;&nbsp;<%= number_with_precision(grand_bonus, :precision => 0, :delimiter => ',') %></h3>
    </div>

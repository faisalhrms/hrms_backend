      <% selling_data.each do |pay_invoice| %>
        <tr style="border:2px solid #ececec;border-top:0px">
          <% actual_serving_days = 0 %>
          <% item = PayItem.find_by(:name => bonus_item_name) %>
          <% if item.is_bonus == true %>
            <% if not item.bonus_date.nil? %>
              <% bonus_date = item.bonus_date %>
              <% item_eligible_date = ReportFormat.bonus_eligibility(pay_invoice.employee, bonus_item_name) %>
              <% if not item_eligible_date.nil? %>
                <% if item_eligible_date <= bonus_date.to_date %>
                  <% start_time = Time.new(item_eligible_date.to_date.year,item_eligible_date.to_date.month,item_eligible_date.to_date.day) %>
                  <% end_time = Time.new(bonus_date.to_date.year,bonus_date.to_date.month,bonus_date.to_date.day) %>
                  <% actual_serving_days = (TimeDifference.between(start_time, end_time).in_days) + 1 %>
                  <% if actual_serving_days > 365 %>
                    <% actual_serving_days = 365 %>
                  <% end %>
                <% else %>
                  <% actual_serving_days = 0 %>
                <% end %>
              <% else %>
                <% actual_serving_days = 0 %>
              <% end %>
            <% end %>
          <% end %>

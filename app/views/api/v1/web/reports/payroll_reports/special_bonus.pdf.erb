          <td> <%= pay_invoice.employee_code %> </td>
          <td> <%= pay_invoice.employee_name %> </td>
          <td> <%= pay_invoice.designation_name %> </td>
          <td> <%= ReportFormat.date_format(pay_invoice.joining_date) %> </td>
          <td> <%= number_with_precision((TempTblBonu.where(:emp_code => pay_invoice.employee.employee_code).sum(:jan)), :precision => 0, :delimiter => ',') %> </td>
          <td> <%= number_with_precision((TempTblBonu.where(:emp_code => pay_invoice.employee.employee_code).sum(:feb)), :precision => 0, :delimiter => ',') %> </td>
          <td> <%= number_with_precision((TempTblBonu.where(:emp_code => pay_invoice.employee.employee_code).sum(:mar)), :precision => 0, :delimiter => ',') %> </td>
          <td> <%= number_with_precision((TempTblBonu.where(:emp_code => pay_invoice.employee.employee_code).sum(:apr)), :precision => 0, :delimiter => ',') %> </td>
          <td> <%= number_with_precision((TempTblBonu.where(:emp_code => pay_invoice.employee.employee_code).sum(:may)), :precision => 0, :delimiter => ',') %> </td>

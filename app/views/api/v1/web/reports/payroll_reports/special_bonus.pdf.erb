      <% elsif cost_center.name == "Administration" %>
        <% admin_cost_center_id = cost_center.id %>
      <% elsif cost_center.name == "Selling" %>
        <% selling_cost_center_id = cost_center.id %>
      <% elsif cost_center.name == "Sales" %>

          <td> <%= number_with_precision((TempTblBonu.where(:emp_code => pay_invoice.employee.employee_code).sum(:oct)), :precision => 0, :delimiter => ',') %> </td>
          <td> <%= number_with_precision((TempTblBonu.where(:emp_code => pay_invoice.employee.employee_code).sum(:nov)), :precision => 0, :delimiter => ',') %> </td>
          <td> <%= number_with_precision((TempTblBonu.where(:emp_code => pay_invoice.employee.employee_code).sum(:dec)), :precision => 0, :delimiter => ',') %> </td>
          <td> <%= number_with_precision((0), :precision => 0, :delimiter => ',') %> </td>
          <td> <%= number_with_precision((TempTblBonu.where(:emp_code => pay_invoice.employee.employee_code).sum(:total)), :precision => 0, :delimiter => ',') %> </td>
          <td> <%= number_with_precision((pay_invoice.pay_invoice_details.where(:item_name => bonus_item_name).sum(:amount).to_f.round), :precision => 0, :delimiter => ',') %> </td>
          <td> <%= number_with_precision((actual_serving_days), :precision => 0, :delimiter => ',') %> </td>
          <td> <%= number_with_precision((0), :precision => 0, :delimiter => ',') %> </td>
          <td> <%= number_with_precision((0), :precision => 0, :delimiter => ',') %> </td>
          <td> <%= number_with_precision((pay_invoice.pay_invoice_details.where(:item_name => bonus_item_name).sum(:amount).to_f.round), :precision => 0, :delimiter => ',') %> </td>
          <% count = count + 1 %>
        </tr>

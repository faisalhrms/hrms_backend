    <% manufacturing_data           = @pay_invoices.where(:cost_center_id => manufacturing_cost_center_ids).order('employee_id ASC') %>
    <% admin_data                   = @pay_invoices.where(:cost_center_id => admin_cost_center_ids).order('employee_id ASC') %>
    <% selling_data                 = @pay_invoices.where(:cost_center_id => selling_cost_center_ids).order('employee_id ASC') %>

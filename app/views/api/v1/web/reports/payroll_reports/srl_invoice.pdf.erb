                </tr>
                </tbody>
              </table>
            </div>
          </div>
        <% end %>
      <% end %>
      <p style="text-align:right; font-size:8px;margin-top:20px;">This is System generated PaySlip does not require any signature <%= Time.now.strftime("%d %B %Y")%></p>
    </div>
  <% else %>
    <div style="width:1400px;padding:20px;box-sizing:border-box;position:relative;font-family:Lato,sans-serif">
      Access Denied
    </div>
  <% end %>
<% end %>
</body>

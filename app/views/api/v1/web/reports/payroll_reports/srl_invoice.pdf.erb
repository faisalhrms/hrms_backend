                    <% total_deduction = total_deduction +@pay_invoice.pay_invoice_details.where(:item_name => "Other Deduction").sum(:amount).round %>
                  </td>
                </tr>
                <tr style="border:2px solid #ECECEC;border-top:0px;">
                  <td style="padding: 5px 0px 5px 10px;">Bike Loan</td>

                    <%= @pay_invoice.pay_invoice_details.where(:item_name => ["Annual Bonus"]).sum(:amount).round %>
                    <% total_other_earning = total_other_earning + @pay_invoice.pay_invoice_details.where(:item_name => ["Annual Bonus"]).sum(:amount).round %>

                    <%= @pay_invoice.pay_invoice_details.where(:item_name => ["LWP", "Attendance Deduction"]).sum(:amount).round %>
                    <% total_deduction = total_deduction + @pay_invoice.pay_invoice_details.where(:item_name => ["LWP", "Attendance Deduction"]).sum(:amount).round %>
                  </td>
                </tr>

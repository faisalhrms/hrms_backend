                </tr>
                <tr style="border-top:2px solid #4a4a4a;border-left:2px solid #4a4a4a;">
                  <td style="padding: 5px 0px 5px 10px;background-color:#4a4a4a;color:#fff">Gross Salary</td>
                  <td style="text-align:right;padding: 5px 10px 5px 0px;border-right:2px solid #ececec;border-bottom:2px solid #ececec;">
                    <%= number_with_delimiter(@pay_invoice.actual_salary.round) %>
                    <% total_earning = total_earning + @pay_invoice.payable_gross.round %>

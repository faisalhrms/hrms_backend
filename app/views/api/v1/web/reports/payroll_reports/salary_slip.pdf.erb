<!DOCTYPE html>
<html>
<head>
  <meta http-equiv="content-type" content="text/html; charset=utf-8" />
  <title><%= @pay_invoice.employee_name %> Salary Slip</title>
  <style type="text/css">
    body{
      margin:0;
      font-family: Arial, Helvetica, sans-serif;
      font-size: 14px;
    }
    .page-break {
      display: block;
      clear: both;
      page-break-after: always;
    }
    .container:after{
      content: "";
      display: block;
      clear: both;
    }
    table { page-break-inside:auto; border-collapse: collapse; }
    tr    { page-break-inside:avoid; page-break-after:auto }
    td    {font-family: 'Jameel Noori Nastaleeq','Alvi Nastaleeq','Pak Nastaleeq','Nafees Web Naskh','Urdu Naskh Asiatype',Tahoma,'Lucida Grande',Verdana,Arial,Sans-Serif;}
    thead { display:table-header-group }
    tfoot { display:table-footer-group }
  </style>
</head>
<body>
<% total_earning = 0%>
<% gross_salary = 0%>
<% basic_pay = 0 %>
<% house_rent = 0 %>
<% utility_allowance = 0 %>
<% medical_allowance = 0 %>
<% washing_allowance = 0 %>
<% conveyance_allowance = 0 %>
<% incentive = @pay_invoice.pay_invoice_details.where(:item_name => "Incentive-F").sum(:amount).round(2) %>
<% other_allow = 0 %>
<% overtime_amount = @pay_invoice.pay_invoice_details.where(:item_name => "Over Time").sum(:amount).round(2) %>
<% @pay_invoice.pay_invoice_details.where(:item_type => "Earning").order('id ASC').each do |invoice_detail|%>
  <% if invoice_detail.show_in_slip == true %>
    <% if invoice_detail.part_of_gross_salary == true and invoice_detail.part_of_other == false %>
      <% if invoice_detail.item_name == "Basic Salary" %>
        <% item = PayItem.find(invoice_detail.item_id) %>
        <% basic_pay = PayItem.actual_calculate_formula_for_slip(@employee, item, @pay_invoice).round(2) %>
      <% elsif invoice_detail.item_name == "House Rent" %>
        <% item = PayItem.find(invoice_detail.item_id) %>
        <% house_rent = PayItem.actual_calculate_formula_for_slip(@employee, item, @pay_invoice).round(2) %>
      <% elsif invoice_detail.item_name == "Utility Allowance" %>
        <% item = PayItem.find(invoice_detail.item_id) %>
        <% utility_allowance = PayItem.actual_calculate_formula_for_slip(@employee, item, @pay_invoice).round(2) %>
      <% elsif invoice_detail.item_name == "Medical Allowance" %>
        <% item = PayItem.find(invoice_detail.item_id) %>
        <% medical_allowance = PayItem.actual_calculate_formula_for_slip(@employee, item, @pay_invoice).round(2) %>
      <% elsif invoice_detail.item_name == "Washing Allowance" %>
        <% item = PayItem.find(invoice_detail.item_id) %>
        <% washing_allowance = PayItem.actual_calculate_formula_for_slip(@employee, item, @pay_invoice).round(2) %>
      <% elsif invoice_detail.item_name == "Conveyance Allowance" %>
        <% item = PayItem.find(invoice_detail.item_id) %>
        <% conveyance_allowance = PayItem.actual_calculate_formula_for_slip(@employee, item, @pay_invoice).round(2) %>
      <% else %>
        <% other_allow = invoice_detail.amount.round(2) %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<% gross_salary = @pay_invoice.actual_salary %>
<% total_earning = @pay_invoice.total_earning.round %>
<% total_earning = PayRollReportData.round_gross_pay(@pay_invoice, total_earning) %>
<% provident_fund = @pay_invoice.pay_invoice_details.provident_fund %>
<% loan = @pay_invoice.pay_invoice_details.loan %>
<% advance = @pay_invoice.pay_invoice_details.advance %>
<% income_tax = @pay_invoice.monthly_tax.round(2) %>
<% electric_bill = @pay_invoice.pay_invoice_details.electric_bill %>
<% eobi = @pay_invoice.pay_invoice_details.eobi %>
<% mess = @pay_invoice.pay_invoice_details.mess_deduction %>
<% premium = @pay_invoice.pay_invoice_details.insurance_premium_gli %>
<% misc_deduction = @pay_invoice.pay_invoice_details.misc_deduction %>
<% canteen_deduction = @pay_invoice.pay_invoice_details.canteen_deduction %>
<% total_deduction = provident_fund + loan + advance + income_tax + electric_bill + eobi + mess + premium + misc_deduction + canteen_deduction %>
<% gross_pay = @pay_invoice.pay_invoice_details.where(:item_name => ["Basic Salary", "House Rent", "Utility Allowance"]).sum(:amount).round + medical_allowance %>
<% gross_pay = PayRollReportData.round_gross_pay(@pay_invoice, gross_pay) %>
<div style="width:1400px;padding:15px;position:relative;">
  <div style="border-top: 2px solid #000">
    <p style="font-weight: 600;">Department: <span style="background-color: #ccc; padding: 5px; margin-left: 30px;"><%= @employee.department_name %></span></p>
    <p style="font-weight: 900;">Section: <span style="margin-left: 60px; text-decoration: underline"><%= @employee.sub_department_name %></span></p>
  </div>
  <p style="font-weight: 900; font-size: 13px; margin-top: 20px; margin-bottom: 5px">Salary Slip for the Month of <%= @pay_invoice.pay_execution.formated_pay_month %></p>
  <div style="border: 2px solid #000; border-radius: 10px; padding: 10px;">
    <table style="width: 100%;">
      <tbody>
      <tr>
        <td style="width: 350px">
          <table style="width: 100%">
            <tbody>
            <tr>
              <td style="font-weight: 900; padding: 5px 0; width: 150px">Employee ID:</td>
              <td style="font-weight: 900;"><%= @employee.employee_code %></td>
            </tr>
            <tr>
              <td style="font-weight: 900; padding: 5px 0;">Employee's Name:</td>
              <td><%= @employee.full_name %></td>
            </tr>
            <tr>
              <td style="font-weight: 600; padding: 5px 0;">Father's Name:</td>
              <td><%= @employee.father_name %></td>
            </tr>
            <tr>
              <td style="font-weight: 600; padding: 5px 0;">Designation:</td>
              <td><%= @employee.designation_name %></td>
            </tr>
            </tbody>
          </table>
        </td>
        <td style="vertical-align: top;">
          <table style="width: 100%;">
            <tr>
              <td style="font-weight: 900"><%= "#{@employee.company_name} (#{@employee.location_name})" %></td>
              <td style="font-weight: 600">Provident Fund Contribution</td>
              <td style="font-weight: 600"><%= PayRollReportData.employee_total_pf_cont(@pay_invoice) %></td>
              <td style="font-weight: 600; font-size: 12px; font-style: italic;">Print Date & Time:</td>
              <td style="font-weight: 600; font-size: 12px;"><%= ReportFormat.date_format(Date.today.to_date) %> <span style="margin-left: 10px"><%= Time.now.to_s(:time) %></span></td>
            </tr>
          </table>
          <% emp_leave_data = EmployeeAttendance.employee_leaves([@pay_invoice]) %>
          <table style="margin-top: 40px; width: 50%; margin-left: auto">
            <tbody>
            <tr>
              <td style="font-weight: 600; padding: 4px 10px">Attendance Detail:</td>
              <td style="font-weight: 600; padding: 4px 10px">ML:</td>
              <td style="padding: 4px 10px; text-align: center"><%= emp_leave_data[@pay_invoice.id]["ml"] %></td>
              <td style="font-weight: 600; padding: 4px 10px">AL:</td>
              <td style="padding: 4px 10px; text-align: center"><%= emp_leave_data[@pay_invoice.id]["al"] %></td>
              <td style="font-weight: 600; padding: 4px 10px">LWP:</td>
              <td style="padding: 4px 10px; text-align: center"><%= emp_leave_data[@pay_invoice.id]["lwp"] %></td>
            </tr>
            <tr>
              <td style="font-weight: 600; padding: 4px 10px"></td>
              <td style="font-weight: 600; padding: 4px 10px">CL:</td>
              <td style="padding: 4px 10px; text-align: center"><%= emp_leave_data[@pay_invoice.id]["cl"] %></td>
              <td style="font-weight: 600; padding: 4px 10px">Rest:</td>
              <td style="padding: 4px 10px; text-align: center"><%= emp_leave_data[@pay_invoice.id]["rest"] %></td>
              <td style="font-weight: 600; padding: 4px 10px">Absent:</td>
              <td style="padding: 4px 10px; text-align: center"><%= emp_leave_data[@pay_invoice.id]["absent"] %></td>
            </tr>
            </tbody>
          </table>
        </td>
      </tr>
      </tbody>
    </table>

    <table style="width: 100%; margin-top: 5px; border-top: 3px solid #000">
      <tr>
        <td style="width: 26%; border-right: 1px solid #000; vertical-align: top; padding: 5px">
          <table style="width: 100%">
            <tr>
              <td style="font-weight: 600; font-size: 16px; padding: 4px 0" colspan="2">Gross Salary:</td>
              <td style="font-weight: 600; font-size: 16px; text-align: right; font-family: Courier, monospace; padding: 4px 0"><%= number_with_delimiter(gross_salary) %></td>
            </tr>
            <tr>
              <td style="font-weight: 600; font-size: 16px; padding: 4px 0" colspan="2">Worked Days:</td>
              <td style="font-weight: 600; font-size: 16px; text-align: right; font-family: Courier, monospace; padding: 4px 0"><%= number_with_delimiter(PayInvoice.invoice_worked_days(@pay_invoice)) %></td>
            </tr>
            <tr>
              <td style="font-weight: 600; padding: 4px 0">Basic Pay:</td>
              <td style="text-align: right; font-family: Courier, monospace; padding: 4px 0;"><%= number_with_delimiter(basic_pay) %></td>
              <td style="text-align: right; padding: 4px 0; font-weight: 600">:oکل تنخوا</td>
            </tr>
            <tr>
              <td style="font-weight: 600; padding: 4px 0">House Rent:</td>
              <td style="text-align: right; font-family: Courier, monospace; padding: 4px 0;"><%= number_with_delimiter(house_rent) %></td>
              <td style="text-align: right; padding: 4px 0; font-weight: 600">:رہائشی الاؤنس</td>
            </tr>
            <tr>
              <td style="font-weight: 600; padding: 4px 0">Utility Allow:</td>
              <td style="text-align: right; font-family: Courier, monospace; padding: 4px 0;"><%= number_with_delimiter(utility_allowance) %></td>
              <td style="text-align: right; padding: 4px 0; font-weight: 600">:یوٹیلیٹی الاؤنس</td>
            </tr>
            <tr>
              <td style="font-weight: 600; padding: 4px 0">Medical:</td>
              <td style="text-align: right; font-family: Courier, monospace; padding: 4px 0;"><%= number_with_delimiter(medical_allowance) %></td>
              <td style="text-align: right; padding: 4px 0; font-weight: 600">:میڈیکل الاؤنس</td>
            </tr>
            <tr>
              <td style="font-weight: 600; padding: 4px 0">Washing Allow:</td>
              <td style="text-align: right; font-family: Courier, monospace; padding: 4px 0;"><%= number_with_delimiter(washing_allowance) %></td>
              <td style="text-align: right; padding: 4px 0; font-weight: 600">:واشنگ الاؤنس</td>
            </tr>
            <tr>
              <td style="font-weight: 600; padding: 4px 0">Convey. Allow:</td>
              <td style="text-align: right; font-family: Courier, monospace; padding: 4px 0;"><%= number_with_delimiter(conveyance_allowance) %></td>
              <td style="text-align: right; padding: 4px 0; font-weight: 600">:کنویونس الاؤنس</td>
            </tr>
            <tr>
              <td style="font-weight: 600; padding: 4px 0">Incentive:</td>
              <td style="text-align: right; font-family: Courier, monospace; padding: 4px 0;"><%= number_with_delimiter(incentive) %></td>
              <td style="text-align: right; padding: 4px 0; font-weight: 600">:مراعات</td>
            </tr>
            <tr>
              <td style="font-weight: 600; padding: 4px 0">Other Allow:</td>
              <td style="text-align: right; font-family: Courier, monospace; padding: 4px 0;"><%= number_with_delimiter(other_allow) %></td>
              <td style="text-align: right; padding: 4px 0; font-weight: 600">:دیگر الاؤنس</td>
            </tr>
            <tr>
              <td style="font-weight: 600; padding: 4px 0">Salary Arrears:</td>
              <td style="text-align: right; font-family: Courier, monospace; padding: 4px 0;"><%= number_with_delimiter(@employee.fixed_pay_items.where(is_active: true, pay_item_id: PayItem.find_by_name("Salary Arrears").id).sum(&:item_amount)) %></td>
              <td style="text-align: right; padding: 4px 0; font-weight: 600"></td>
            </tr>
          </table>
        </td>
        <td style="width: 24%; border-right: 1px solid #000; vertical-align: top; padding: 5px">
          <p style="font-size: 16px; font-weight: 600; margin: 0 0 5px">Earning:</p>
          <table style="width: 100%">
            <tbody>
            <tr>
              <td style="font-weight: 600; padding: 4px 0">Payable:</td>
              <td style="font-weight: 600; font-size: 18px; text-align: right; font-family: Courier, monospace; padding: 4px 0"><%= number_with_delimiter(total_earning) %></td>
              <td style="text-align: right; padding: 4px 0; font-weight: 600; font-size: 16px">oکل تنخوا</td>
            </tr>
            <tr>
              <td colspan="3" style="font-size: 16px; font-weight: 600; padding: 20px 0 4px">Overtime:</td>
            </tr>
            <tr>
              <td style="font-weight: 600; padding: 4px 0">OT Hours:</td>
              <td style="text-align: right; font-family: Courier, monospace; padding: 4px 0;"><%= @pay_invoice.over_time_hours %></td>
              <td style="text-align: right; padding: 4px 0; font-weight: 600; font-size: 16px">کل اور ٹائم</td>
            </tr>
            <tr>
              <td style="font-weight: 600; padding: 6px 0 4px">OT Amnt:</td>
              <td style="text-align: right; font-family: Courier, monospace; padding: 6px 0 4px;"><%= number_with_delimiter(overtime_amount) %></td>
              <td style="text-align: right; padding: 6px 0 4px; font-weight: 600; font-size: 16px">اور ٹائم کی رقم</td>
            </tr>
            <tr>
              <td colspan="3" style="text-align: center; font-weight: 600; font-size: 18px; padding: 35px 0 6px">Total Earning:</td>
            </tr>
            <tr>
              <td colspan="3" style="font-weight: 600; font-size: 16px; text-align: center; padding: 5px 0; font-family: Courier, monospace; border-top: 2px solid #000; border-bottom: 2px solid #000"><%= number_with_delimiter(total_earning) %></td>
            </tr>
            </tbody>
          </table>
        </td>
        <td style="width: 24%; border-right: 1px solid #000; vertical-align: top; padding: 5px">
          <table style="width: 100%">
            <tr>
              <td style="font-weight: 600; font-size: 16px; padding: 4px 0" colspan="2">Deductions:</td>
              <td style="text-align: right; padding: 4px 0; font-weight: 600; font-size: 16px">:کٹوتی</td>
            </tr>
            <tr>
              <td style="font-weight: 600; padding: 4px 0">P. Fund:</td>
              <td style="text-align: right; font-family: Courier, monospace; padding: 4px 0;"><%=number_with_delimiter(provident_fund)%></td>
              <td style="text-align: right; padding: 4px 0; font-weight: 600">:پروویڈنٹ فنڈ</td>
            </tr>
            <tr>
              <td style="font-weight: 600; padding: 4px 0">Loan:</td>
              <td style="text-align: right; font-family: Courier, monospace; padding: 4px 0;"><%=number_with_delimiter(loan)%></td>
              <td style="text-align: right; padding: 4px 0; font-weight: 600">:قرض</td>
            </tr>
            <tr>
              <td style="font-weight: 600; padding: 4px 0">Advance:</td>
              <td style="text-align: right; font-family: Courier, monospace; padding: 4px 0;"><%=number_with_delimiter(advance)%></td>
              <td style="text-align: right; padding: 4px 0; font-weight: 600">:ایڈوانس</td>
            </tr>
            <tr>
              <td style="font-weight: 600; padding: 4px 0">Income Tax:</td>
              <td style="text-align: right; font-family: Courier, monospace; padding: 4px 0;"><%=number_with_delimiter(income_tax)%></td>
              <td style="text-align: right; padding: 4px 0; font-weight: 600">:انکم ٹیکس</td>
            </tr>
            <tr>
              <td style="font-weight: 600; padding: 4px 0">Electric Bill:</td>
              <td style="text-align: right; font-family: Courier, monospace; padding: 4px 0;"><%=number_with_delimiter(electric_bill)%></td>
              <td style="text-align: right; padding: 4px 0; font-weight: 600">:بجلی کا بل</td>
            </tr>
            <tr>
              <td style="font-weight: 600; padding: 4px 0">EOBI:</td>
              <td style="text-align: right; font-family: Courier, monospace; padding: 4px 0;"><%=number_with_delimiter(eobi)%></td>
              <td style="text-align: right; padding: 4px 0; font-weight: 600">:ای او بی آئی</td>
            </tr>
            <tr>
              <td style="font-weight: 600; padding: 4px 0">Mess:</td>
              <td style="text-align: right; font-family: Courier, monospace; padding: 4px 0;"><%=number_with_delimiter(mess)%></td>
              <td style="text-align: right; padding: 4px 0; font-weight: 600">:میس کا بل</td>
            </tr>
            <tr>
              <td style="font-weight: 600; padding: 4px 0">Premium:</td>
              <td style="text-align: right; font-family: Courier, monospace; padding: 4px 0;"><%=number_with_delimiter(premium)%></td>
              <td style="text-align: right; padding: 4px 0; font-weight: 600">:قسط ادائیگی</td>
            </tr>
            <tr>
              <td style="font-weight: 600; padding: 4px 0">Misc. Deduc:</td>
              <td style="text-align: right; font-family: Courier, monospace; padding: 4px 0;"><%=number_with_delimiter(misc_deduction)%></td>
              <td style="text-align: right; padding: 4px 0; font-weight: 600">:متفرق کٹوتی</td>
            </tr>
            <tr>
              <td style="font-weight: 600; padding: 4px 0">Canteen Deduc:</td>
              <td style="text-align: right; font-family: Courier, monospace; padding: 4px 0;"><%=number_with_delimiter(canteen_deduction)%></td>
              <td style="text-align: right; padding: 4px 0; font-weight: 600">:کینٹین کٹوتی</td>
            </tr>
            <tr>
              <td colspan="3" style="height: 20px"></td>
            </tr>
            <tr>
              <td></td>
              <td style="padding: 6px; font-weight: 600; font-size: 16px; font-family: Courier, monospace; border-top: 2px solid #000; border-bottom: 2px solid #000; text-align: right"><%= number_with_delimiter(total_deduction) %></td>
              <td style="font-weight: 600; font-size: 16px; text-align: right">:کل کٹوتی</td>
            </tr>
          </table>
        </td>
        <td style="vertical-align: top; padding: 5px">
          <table style="width: 100%">
            <tr>
              <td style="font-weight: 600; font-size: 16px; padding: 4px 0" colspan="2">Net Pay:</td>
              <td style="text-align: right; padding: 4px 0; font-weight: 600; font-size: 18px">:oواجب الدا تنخوا</td>
            </tr>
          </table>
          <p style="margin: 230px 0 0; font-family: Courier, monospace; font-size: 18px; font-weight: 600; text-align: right; border-top: 2px solid #000; border-bottom: 2px solid #000; padding: 5px"><%= number_with_delimiter(total_earning - total_deduction) %></p>
        </td>
      </tr>
    </table>
  </div>

  <p style="margin: 5px 0; font-weight: 600; font-size: 16px;padding: 0 0 5px 20px; border-bottom: 2px dashed #000">1</p>

  <p style="margin-top: 40px; font-weight: 900; font-size: 16px; font-style: italic;">
    <span style="margin-left: 5px; font-style: normal; font-family:Courier, monospace;"><%= number_with_delimiter(total_earning) %></span>
  </p>

  <table style="width: 100%">
    <tr>
      <td style="font-weight: 600; font-size: 16px; padding: 4px 0" colspan="2"></td>
      <td style="font-weight: 600; font-size: 16px; padding: 4px 0" colspan="2">Gross Pay:</td>
      <td style="font-weight: 900; font-size: 16px; padding: 4px 0" colspan="2">Overtime:</td>
      <td style="font-weight: 600; font-size: 16px; padding: 4px 0" colspan="2">Total Earning:</td>
      <td style="font-weight: 600; font-size: 16px; padding: 4px 0" colspan="2">Deductions:</td>
      <td style="font-weight: 900; font-size: 16px; padding: 4px 0" colspan="2">Net Pay:</td>
    </tr>
    <tr>
      <td style="font-weight: 600; font-size: 16px; padding: 4px 0" colspan="2"></td>
      <td style="font-weight: 600; font-size: 16px; padding: 4px 0" colspan="2"><%= number_with_delimiter(gross_pay) %></td>
      <td style="font-weight: 900; font-size: 16px; padding: 4px 0" colspan="2"><%= number_with_delimiter(overtime_amount) %></td>
      <td style="font-weight: 600; font-size: 16px; padding: 4px 0" colspan="2"><%= number_with_delimiter(total_earning) %></td>
      <td style="font-weight: 600; font-size: 16px; padding: 4px 0" colspan="2"><%= number_with_delimiter(total_deduction) %></td>
      <td style="font-weight: 900; font-size: 16px; padding: 4px 0" colspan="2"><%= number_with_delimiter(total_earning - total_deduction) %></td>
    </tr>
  </table>
</div>
<div class="float-container" style="margin-top: 40px;">
  <p>YOUR SALARY HAS BEEN DEPOSITED INTO</p>
  <div style="width:100%;float:left;padding-right:20px;box-sizing:border-box;">
    <table style="border-collapse:collapse;width:100%;table-layout:fixed;">
      <thead>
      <tr style="background-color:#4a4a4a;color:#fff">
        <th style="text-align:center;text-transform:uppercase;font-weight: 300;font-size: 12px;padding:5px;">
          BANK NAME
        </th>
        <th style="text-align:center;text-transform:uppercase;font-weight: 300;font-size: 12px;padding:5px;">
          BRANCH
        </th>
        <th style="text-align:center;text-transform:uppercase;font-weight: 300;font-size: 12px;padding:5px;">
          BRANCH CODE
        </th>
        <th style="text-align:center;text-transform:uppercase;font-weight: 300;font-size: 12px;padding:5px;">
          ACCOUNT <TITLE></TITLE>
        </th>
        <th style="text-align:center;text-transform:uppercase;font-weight: 300;font-size: 12px;padding:5px;">
          ACCOUNT NO.
        </th>
      </tr>
      </thead>
      <tbody style="font-size:12px;text-transform: uppercase;">
      <tr style="border:2px solid #ECECEC;border-top:0px;">
        <td style="text-align:center;padding: 5px 10px 5px 0px;"> <%= @pay_invoice.employee.bank_name %> </td>
        <td style="text-align:center;padding: 5px 10px 5px 0px;"> <%= @pay_invoice.employee.bank_branch_name %> </td>
        <td style="text-align:center;padding: 5px 10px 5px 0px;"> <%= @pay_invoice.employee.bank_branch_code %> </td>
        <td style="text-align:center;padding: 5px 10px 5px 0px;"> <%= @pay_invoice.employee.bank_account_title %> </td>
        <td style="text-align:center;padding: 5px 10px 5px 0px;"> <%= @pay_invoice.employee.bank_account_number %> </td>
      </tr>
      </tbody>
    </table>
  </div>
</div>
</body>
</html>
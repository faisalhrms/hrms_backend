<!DOCTYPE html>
<html>
<head>
  <title>Salary Register</title>
  <style type="text/css">
    .page-break {
      display: block;
      clear: both;
      page-break-after: always;
    }
    .container:after{
      content: "";
      display: block;
      clear: both;
    }
    table { page-break-inside:auto }
    tr    { page-break-inside:avoid; page-break-after:auto }
    thead { display:table-header-group }
    tfoot { display:table-footer-group }
  </style>
</head>

<body>
<div style="text-align:right;font-size:10px">
  <%= "Extraction Date - #{DateTime.now.strftime("%B %d, %Y %I:%M %P")} "%>
</div>
<div style="width:1970px;padding:20px;box-sizing:border-box;position:relative;font-family:Lato,sans-serif">
  <% if not (@company.avatar_file_name.nil? or @company.avatar_file_name.blank?) %>
    <img src=<%= @company.avatar.url %> style="width:200px;height:75px;position:absolute">
  <% end %>
  <div style="height:60px;margin-top:40px;">
    <% if @salary_unit_name == "SDL" %>
      <h1 style="text-align:center;font-size:16.6666667px;font-weight:300;margin-bottom:0px;">Sapphire Dairies Pvt Ltd</h1>
    <% else %>
      <h1 style="text-align:center;text-transform:uppercase;font-size:16.6666667px;font-weight:300;margin-bottom:0px;"><%= @company.name %></h1>
    <% end %>
    <h1 style="text-align:center;text-transform:uppercase;font-size:14px;font-weight:300;margin-bottom:0px;">EMPLOYEE SALARY REGISTER REPORT</h1>
    <h2 style="text-align:center;text-transform:uppercase;font-size:12px;font-weight:300;margin-bottom:0px;">
      <% if not @salary_unit_name.blank? %>
        <%= @salary_unit_name %>
      <% end %>
    </h2>
    <h2 style="text-align:center;text-transform:uppercase;font-size:12px;font-weight:300;margin-bottom:0px;"><%= params[:pay_month].to_date.strftime("%B %Y") %></h2>
  </div>
  <% if params[:manual_register] == "true" %>
    <% cashed_employees_ids = Employee.where(payment_method: 'Cash').active.pluck(:id) %>
    <% cashed_employee         = @pay_invoices.where(employee_id: cashed_employees_ids).order('employee_id ASC') %>
    <% @dept_pay_invoices = @pay_invoices.where.not(employee_id: cashed_employees_ids).order('employee_id ASC') %>
    <% selling_departments  = Department.where(:name => ['Marketing', 'Export', 'Marketing&Export', 'Supply Chain', 'Sales']) %>
    <% admin_departments    = Department.where.not(:name => ['Marketing', 'Export', 'Marketing&Export', 'Supply Chain', 'Sales']) %>
    <% admin_data           = @dept_pay_invoices.where(:department_id => admin_departments.collect(&:id)).order('employee_id ASC') %>
    <% selling_data         = @dept_pay_invoices.where(:department_id => selling_departments.collect(&:id)).order('employee_id ASC') %>
    <% count = 1 %>
    <% insurance_premium = PayItem.find_by_code("Insurance Premium GLI") %>
    <% is_insurance_prem_allowed = ItemExecutionDetail.find_by(pay_execution_id: @pay_execution.id, pay_item_id: insurance_premium.try(:id), status: "Allowed").present? ? true : false %>
    <% cost_center_ids = @pay_invoices.collect(&:cost_center_id).uniq %>
    <% cost_count = 0 %>
    <% CostCenter.where(:id => cost_center_ids).order('name ASC').each do |cost_center| %>
      <% cost_count = cost_count + 1 %>
      <% salary_data = @pay_invoices.where(:cost_center_id => cost_center.id).order('employee_id ASC') %>

    <h3><%= cost_center.name %></h3>
    <table class="main-table" style="width:100%;margin-top:30px;border-collapse:collapse">
      <thead style="text-align:center;font-size: 10px;">
      <tr style="background-color:#4a4a4a;border:2px solid #4a4a4a;border-bottom:0px;">
        <th>SR NO.</th>
        <th>Emp Code</th>
        <th>Name</th>
        <th>Designation</th>
        <th>Department</th>
        <th>Working Days</th>
        <th>Basic Salary</th>
        <th>House Rent</th>
        <th>Medical </th>
        <th>Utility Allowance</th>
        <th>Gross Salary</th>
        <th>Medi. Allow</th>
        <th>Other Allow</th>
        <th>Incentive </th>
        <th>Leave Encashment Arrears</th>
        <th>Leave Encashment</th>
        <th>Leave Fare Assistance</th>
        <th>Annual Bonus</th>
        <th>Arrears</th>
        <th>Total</th>
        <th>LWP</th>
        <th>Income Tax</th>
        <th>Advance</th>
        <th>Loan</th>
        <th>EPF</th>
        <th>AEPF</th>
        <th>EOBI</th>
        <th>EOBI Deduction</th>
        <th>Other Deduction</th>
        <th>Bike Loan</th>
        <th>Mess Deduction</th>
        <% if is_insurance_prem_allowed %>
          <th>Insurance Premium GLI</th>
        <% end %>
        <th>Total Deduction</th>
        <th>Net Amount</th>
        <th>Net Payable</th>
        <th>ERPF</th>
        <th>AERPF</th>
        <th>PF Total</th>
      </tr>
      </thead>
      <tbody style="text-align:center;font-size:10px">
      <% salary_data.each do |pay_invoice| %>
        <tr style="border:2px solid #ececec;border-top:0px">
          <td><%= count %></td>
          <td> <%= pay_invoice.employee_code %> </td>
          <td> <%= pay_invoice.employee_name %> </td>
          <td> <%= pay_invoice.designation_name %> </td>
          <td> <%= pay_invoice.department_name %> </td>
          <td> <%= (pay_invoice.no_of_pay_days - (pay_invoice.deduction_days + pay_invoice.short_joining_days)) %> </td>
          <td> <%= number_with_precision((pay_invoice.pay_invoice_details.where(:item_name => "Basic Salary").sum(:amount).to_f.round), :precision => 0, :delimiter => ',') %> </td>
          <td> <%= number_with_precision((pay_invoice.pay_invoice_details.where(:item_name => "House Rent").sum(:amount).to_f.round), :precision => 0, :delimiter => ',') %> </td>
          <td> <%= number_with_precision((pay_invoice.pay_invoice_details.where(:item_name => "Medical").sum(:amount).to_f.round), :precision => 0, :delimiter => ',') %> </td>

          <% diff_amount = pay_invoice.actual_salary - (pay_invoice.pay_invoice_details.where(:item_name => ["Basic Salary", "House Rent", "Medical", "Utility Allowance"]).sum(:amount)).to_f.round %>

          <td> <%= number_with_precision((pay_invoice.pay_invoice_details.where(:item_name => "Utility Allowance").sum(:amount).to_f.round + diff_amount.to_f.round), :precision => 0, :delimiter => ',') %> </td>
          <td> <%= number_with_precision((pay_invoice.pay_invoice_details.where(:item_name => ["Basic Salary", "House Rent", "Medical", "Utility Allowance"]).sum(:amount).to_f.round + diff_amount), :precision => 0, :delimiter => ',') %> </td>
          <td> <%= number_with_precision((pay_invoice.pay_invoice_details.where(:item_name => "Medical Allowance (OPD)").sum(:amount).to_f.round), :precision => 0, :delimiter => ',') %> </td>
          <td> <%= number_with_precision((pay_invoice.pay_invoice_details.where(:item_name => ["Other Allowance", "Fuel Allowance", "Bike Fuel Allowance"]).sum(:amount).to_f.round), :precision => 0, :delimiter => ',') %> </td>
          <td> <%= number_with_precision((pay_invoice.pay_invoice_details.where(:item_name => "Incentive").sum(:amount).to_f.round), :precision => 0, :delimiter => ',') %> </td>
          <td> <%= number_with_precision((pay_invoice.pay_invoice_details.where(:item_name => "Leave Encashment Arrears").sum(:amount).to_f.round), :precision => 0, :delimiter => ',') %> </td>
          <td> <%= number_with_precision((pay_invoice.pay_invoice_details.where(:item_name => "Leave Encashment").sum(:amount).to_f.round), :precision => 0, :delimiter => ',') %> </td>
          <td> <%= number_with_precision((pay_invoice.pay_invoice_details.where(:item_name => "Leave Fare Assistance").sum(:amount).to_f.round), :precision => 0, :delimiter => ',') %> </td>
          <td> <%= number_with_precision((pay_invoice.pay_invoice_details.where(:item_name => "Annual Bonus").sum(:amount).to_f.round), :precision => 0, :delimiter => ',') %> </td>
          <td> <%= number_with_precision((pay_invoice.pay_invoice_details.where(:item_name => ["Salary Arrears", "Increment Arrears",  "Allowance Arrear", "Deduction Reimbursement Arrear", "Manual Arrear", "Arrears", "Over Time", "Off Day Payment"]).sum(:amount).to_f.round), :precision => 0, :delimiter => ',') %> </td>
          <td> <%= number_with_precision(((pay_invoice.pay_invoice_details.where(:item_name => "Basic Salary").sum(:amount).to_f.round + pay_invoice.pay_invoice_details.where(:item_name => "House Rent").sum(:amount).to_f.round + pay_invoice.pay_invoice_details.where(:item_name => "Utility Allowance").sum(:amount).to_f.round + pay_invoice.pay_invoice_details.where(:item_name => "Medical").sum(:amount).to_f.round + pay_invoice.pay_invoice_details.where(:item_name => "Incentive").sum(:amount).to_f.round + pay_invoice.pay_invoice_details.where(:item_name => "Leave Encashment Arrears").sum(:amount).to_f.round + pay_invoice.pay_invoice_details.where(:item_name => "Leave Encashment").sum(:amount).to_f.round + pay_invoice.pay_invoice_details.where(:item_name => "Leave Fare Assistance").sum(:amount).to_f.round + pay_invoice.pay_invoice_details.where(:item_name => "Medical Allowance (OPD)").sum(:amount).to_f.round + pay_invoice.pay_invoice_details.where(:item_name => "Other Allowance").sum(:amount).to_f.round + pay_invoice.pay_invoice_details.where(:item_name => ["Fuel Allowance", "Bike Fuel Allowance"]).sum(:amount).to_f.round + pay_invoice.pay_invoice_details.where(:item_name => "Annual Bonus").sum(:amount).to_f.round + pay_invoice.pay_invoice_details.where(:item_name => ["Salary Arrears", "Increment Arrears",  "Allowance Arrear", "Deduction Reimbursement Arrear", "Manual Arrear", "Arrears", "Over Time", "Off Day Payment"]).sum(:amount).to_f.round + diff_amount) ), :precision => 0, :delimiter => ',') %> </td>
          <td> <%= number_with_precision((pay_invoice.pay_invoice_details.where(:item_name => ["LWP", "Attendance Deduction"]).sum(:amount).to_f.round), :precision => 0, :delimiter => ',') %> </td>
          <td> <%= number_with_precision((pay_invoice.monthly_tax.to_f.round), :precision => 0, :delimiter => ',') %> </td>
          <td> <%= number_with_precision((pay_invoice.pay_invoice_details.where(:item_name => "Advance").sum(:amount).to_f.round), :precision => 0, :delimiter => ',') %> </td>
          <td> <%= number_with_precision((pay_invoice.pay_invoice_details.where(:item_name => "Loan").sum(:amount).to_f.round), :precision => 0, :delimiter => ',') %> </td>

          <% item_value = 0.0 %>
          <td> <%= number_with_precision(((pay_invoice.pay_invoice_details.where(:item_name => "Provident Fund").sum(:amount).to_f.round - item_value)), :precision => 0, :delimiter => ',') %> </td>
          <td> <%= number_with_precision(((pay_invoice.pay_invoice_details.where(:item_name => "Arrears Provident Fund").sum(:amount).to_f.round - item_value)), :precision => 0, :delimiter => ',') %> </td>
          <td> <%= number_with_precision((pay_invoice.pay_invoice_details.where(:item_name => "EOBI").sum(:amount).to_f.round), :precision => 0, :delimiter => ',') %> </td>
          <td> <%= number_with_precision((pay_invoice.pay_invoice_details.where(:item_name => "EOBI Deduction").sum(:amount).to_f.round), :precision => 0, :delimiter => ',') %> </td>
          <td> <%= number_with_precision((pay_invoice.pay_invoice_details.where(:item_name => ["Allowance Deduction", "Salary Deduction", "Other Deduction"]).sum(:amount).to_f.round), :precision => 0, :delimiter => ',') %> </td>
          <td> <%= number_with_precision((pay_invoice.pay_invoice_details.where(:item_name => "Bike Loan").sum(:amount).to_f.round), :precision => 0, :delimiter => ',') %> </td>
          <td> <%= number_with_precision((pay_invoice.pay_invoice_details.where(:item_name => "Mess Deduction").sum(:amount).to_f.round), :precision => 0, :delimiter => ',') %> </td>
          <% if is_insurance_prem_allowed %>
            <td> <%= number_with_precision((pay_invoice.pay_invoice_details.where(:item_name => "Insurance Premium GLI").sum(:amount).to_f.round), :precision => 0, :delimiter => ',') %> </td>
          <% end %>
          <td> <%= number_with_precision(((pay_invoice.pay_invoice_details.where(:item_name => ["LWP", "Attendance Deduction"]).sum(:amount).to_f.round + pay_invoice.monthly_tax + pay_invoice.pay_invoice_details.where(:item_name => "Advance").sum(:amount).to_f.round + pay_invoice.pay_invoice_details.where(:item_name => "Loan").sum(:amount).to_f.round + pay_invoice.pay_invoice_details.where(:item_name => ["Provident Fund", "Arrears Provident Fund"]).sum(:amount).to_f.round + pay_invoice.pay_invoice_details.where(:item_name => "EOBI").sum(:amount).to_f.round + pay_invoice.pay_invoice_details.where(:item_name => "EOBI Deduction").sum(:amount).to_f.round + pay_invoice.pay_invoice_details.where(:item_name => ["Allowance Deduction", "Salary Deduction", "Other Deduction"]).sum(:amount).to_f.round + pay_invoice.pay_invoice_details.where(:item_name => "Bike Loan").sum(:amount).to_f.round + pay_invoice.pay_invoice_details.where(:item_name => "Mess Deduction").sum(:amount).to_f.round + pay_invoice.pay_invoice_details.where(:item_name => "Insurance Premium GLI").sum(:amount).to_f.round)), :precision => 0, :delimiter => ',') %> </td>

          <% net_amount = (pay_invoice.pay_invoice_details.where(:item_name => "Basic Salary").sum(:amount).to_f.round + pay_invoice.pay_invoice_details.where(:item_name => "House Rent").sum(:amount).to_f.round + pay_invoice.pay_invoice_details.where(:item_name => "Utility Allowance").sum(:amount).to_f.round + pay_invoice.pay_invoice_details.where(:item_name => "Medical").sum(:amount).to_f.round + pay_invoice.pay_invoice_details.where(:item_name => "Incentive").sum(:amount).to_f.round + pay_invoice.pay_invoice_details.where(:item_name => "Leave Encashment Arrears").sum(:amount).to_f.round + pay_invoice.pay_invoice_details.where(:item_name => "Leave Encashment").sum(:amount).to_f.round + pay_invoice.pay_invoice_details.where(:item_name => "Leave Fare Assistance").sum(:amount).to_f.round + pay_invoice.pay_invoice_details.where(:item_name => "Medical Allowance (OPD)").sum(:amount).to_f.round + pay_invoice.pay_invoice_details.where(:item_name => "Other Allowance").sum(:amount).to_f.round + pay_invoice.pay_invoice_details.where(:item_name => ["Fuel Allowance", "Bike Fuel Allowance"]).sum(:amount).to_f.round + pay_invoice.pay_invoice_details.where(:item_name => "Annual Bonus").sum(:amount).to_f.round + pay_invoice.pay_invoice_details.where(:item_name => ["Salary Arrears", "Increment Arrears",  "Allowance Arrear", "Deduction Reimbursement Arrear", "Manual Arrear", "Arrears", "Over Time", "Off Day Payment"]).sum(:amount).to_f.round + diff_amount) - (pay_invoice.pay_invoice_details.where(:item_name => ["LWP", "Attendance Deduction"]).sum(:amount).to_f.round + pay_invoice.monthly_tax.to_f.round + pay_invoice.pay_invoice_details.where(:item_name => "Advance").sum(:amount).to_f.round + pay_invoice.pay_invoice_details.where(:item_name => "Loan").sum(:amount).to_f.round + pay_invoice.pay_invoice_details.where(:item_name => ["Provident Fund", "Arrears Provident Fund"]).sum(:amount).to_f.round + pay_invoice.pay_invoice_details.where(:item_name => "EOBI").sum(:amount).to_f.round + pay_invoice.pay_invoice_details.where(:item_name => "EOBI Deduction").sum(:amount).to_f.round + pay_invoice.pay_invoice_details.where(:item_name => ["Allowance Deduction", "Salary Deduction", "Other Deduction"]).sum(:amount).to_f.round + pay_invoice.pay_invoice_details.where(:item_name => "Bike Loan").sum(:amount).to_f.round + pay_invoice.pay_invoice_details.where(:item_name => "Mess Deduction").sum(:amount).to_f.round + pay_invoice.pay_invoice_details.where(:item_name => "Insurance Premium GLI").sum(:amount).to_f.round) %>

          <td> <%= number_with_precision((net_amount.to_f.round), :precision => 0, :delimiter => ',') %> </td>
          <td> <%= number_with_precision((net_amount.to_f.round), :precision => 0, :delimiter => ',') %> </td>
          <td> <%= number_with_precision((pay_invoice.employee_taxable_income.try(:employeer_pf_value).to_f.round - item_value.to_f.round), :precision => 0, :delimiter => ',') %> </td>
          <td> <%= number_with_precision(((pay_invoice.pay_invoice_details.where(:item_name => "Arrears Provident Fund").sum(:amount).to_f.round - item_value)), :precision => 0, :delimiter => ',') %> </td>
          <td> <%= number_with_precision((pay_invoice.pay_invoice_details.where(:item_name => "Provident Fund").sum(:amount).to_f.round + (pay_invoice.pay_invoice_details.where(:item_name => "Arrears Provident Fund").sum(:amount).to_f.round ) + pay_invoice.employee_taxable_income.try(:employeer_pf_value).to_f.round), :precision => 0, :delimiter => ',') %> </td>

          <% count = count + 1 %>

        </tr>
      <% end %>
      <% column_no_1 = 0 %>
      <% column_no_2 = 0 %>
      <% column_no_3 = 0 %>
      <% column_no_4 = 0 %>
      <% column_no_5 = 0 %>
      <% column_no_6 = 0 %>
      <% column_no_7 = 0 %>
      <% column_no_8 = 0 %>
      <% column_no_9 = 0 %>
      <% column_no_10 = 0 %>
      <% column_no_11 = 0 %>
      <% column_no_12 = 0 %>
      <% column_no_13 = 0 %>
      <% column_no_14 = 0 %>
      <% column_no_15 = 0 %>
      <% column_no_16 = 0 %>
      <% column_no_17 = 0 %>
      <% column_no_18 = 0 %>
      <% column_no_19 = 0 %>
      <% column_no_20 = 0 %>
      <% column_no_21 = 0 %>
      <% column_no_22 = 0 %>
      <% column_no_23 = 0 %>
      <% column_no_24 = 0 %>
      <% column_no_25 = 0 %>
      <% column_no_26 = 0 %>
      <% column_no_27 = 0 %>
      <% column_no_30 = 0 %>
      <% column_no_31 = 0 %>
      <% column_no_32 = 0 %>
      <% column_no_33 = 0 %>
      <% if is_insurance_prem_allowed %>
        <% column_no_28 = 0 %>
      <% end %>

      <% salary_data.each do |pay_invoice| %>
        <% column_no_1 = column_no_1 + pay_invoice.pay_invoice_details.where(:item_name => "Basic Salary").sum(:amount).to_f.round %>
        <% column_no_2 = column_no_2 + pay_invoice.pay_invoice_details.where(:item_name => "House Rent").sum(:amount).to_f.round %>
        <% column_no_3 = column_no_3 + pay_invoice.pay_invoice_details.where(:item_name => "Medical").sum(:amount).to_f.round %>

        <% diff_amount = pay_invoice.actual_salary - (pay_invoice.pay_invoice_details.where(:item_name => ["Basic Salary", "House Rent", "Medical", "Utility Allowance"]).sum(:amount)).to_f.round %>
        <% column_no_4 = column_no_4 + pay_invoice.pay_invoice_details.where(:item_name => "Utility Allowance").sum(:amount).to_f.round + diff_amount %>
        <% column_no_5 = column_no_5 + pay_invoice.pay_invoice_details.where(:item_name => ["Basic Salary", "House Rent", "Medical", "Utility Allowance"]).sum(:amount).to_f.round + diff_amount %>
        <% column_no_6 = column_no_6 + pay_invoice.pay_invoice_details.where(:item_name => "Medical Allowance (OPD)").sum(:amount).to_f.round %>
        <% column_no_7 = column_no_7 + pay_invoice.pay_invoice_details.where(:item_name => ["Other Allowance", "Fuel Allowance", "Bike Fuel Allowance"]).sum(:amount).to_f.round %>
        <% column_no_8 = column_no_8 + pay_invoice.pay_invoice_details.where(:item_name => "Incentive").sum(:amount).to_f.round %>
        <% column_no_30 = column_no_30 + pay_invoice.pay_invoice_details.where(:item_name => "Leave Encashment Arrears").sum(:amount).to_f.round %>
        <% column_no_32 = column_no_32 + pay_invoice.pay_invoice_details.where(:item_name => "Leave Encashment").sum(:amount).to_f.round %>
        <% column_no_33 = column_no_33 + pay_invoice.pay_invoice_details.where(:item_name => "Leave Fare Assistance").sum(:amount).to_f.round %>
        <% column_no_9 = column_no_9 + pay_invoice.pay_invoice_details.where(:item_name => "Annual Bonus").sum(:amount).to_f.round %>
        <% column_no_10 = column_no_10 + pay_invoice.pay_invoice_details.where(:item_name => ["Salary Arrears", "Increment Arrears",  "Allowance Arrear", "Deduction Reimbursement Arrear", "Manual Arrear", "Arrears", "Over Time", "Off Day Payment"]).sum(:amount).to_f.round %>
        <% column_no_11 = column_no_11 + (pay_invoice.pay_invoice_details.where(:item_name => "Basic Salary").sum(:amount).to_f.round + pay_invoice.pay_invoice_details.where(:item_name => "House Rent").sum(:amount).to_f.round + pay_invoice.pay_invoice_details.where(:item_name => "Utility Allowance").sum(:amount).to_f.round + pay_invoice.pay_invoice_details.where(:item_name => "Medical").sum(:amount).to_f.round + pay_invoice.pay_invoice_details.where(:item_name => "Incentive").sum(:amount).to_f.round + pay_invoice.pay_invoice_details.where(:item_name => "Leave Encashment Arrears").sum(:amount).to_f.round  + pay_invoice.pay_invoice_details.where(:item_name => "Leave Encashment").sum(:amount).to_f.round  + pay_invoice.pay_invoice_details.where(:item_name => "Leave Fare Assistance").sum(:amount).to_f.round + pay_invoice.pay_invoice_details.where(:item_name => "Medical Allowance (OPD)").sum(:amount).to_f.round + pay_invoice.pay_invoice_details.where(:item_name => "Other Allowance").sum(:amount).to_f.round + pay_invoice.pay_invoice_details.where(:item_name => ["Fuel Allowance", "Bike Fuel Allowance"]).sum(:amount).to_f.round + pay_invoice.pay_invoice_details.where(:item_name => "Annual Bonus").sum(:amount).to_f.round + pay_invoice.pay_invoice_details.where(:item_name => ["Salary Arrears", "Increment Arrears",  "Allowance Arrear", "Deduction Reimbursement Arrear", "Manual Arrear", "Arrears", "Over Time", "Off Day Payment"]).sum(:amount).to_f.round) + diff_amount %>
        <% column_no_12 = column_no_12 + pay_invoice.pay_invoice_details.where(:item_name => ["LWP", "Attendance Deduction"]).sum(:amount).to_f.round %>
        <% column_no_13 = column_no_13 + pay_invoice.monthly_tax.to_f.round %>
        <% column_no_14 = column_no_14 + pay_invoice.pay_invoice_details.where(:item_name => "Advance").sum(:amount).to_f.round %>
        <% column_no_15 = column_no_15 + pay_invoice.pay_invoice_details.where(:item_name => "Loan").sum(:amount).to_f.round %>
        <% pay_item = PayItem.find_by(:name => "Provident Fund Arrear") %>
        <% item_value = 0.0 %>
        <% column_no_16 = column_no_16 + (pay_invoice.pay_invoice_details.where(:item_name => "Provident Fund").sum(:amount).to_f.round - item_value) %>
        <% column_no_17 = column_no_17 + (pay_invoice.pay_invoice_details.where(:item_name => "Arrears Provident Fund").sum(:amount).to_f.round - item_value) %>

<!DOCTYPE html>
<html>
<head>
  <meta http-equiv="content-type" content="text/html; charset=utf-8" />
  <title>Over Time Summary (Sub Dept. Wise)</title>
  <link rel="stylesheet" media="screen" href="http://s3.amazonaws.com/sapphire-hrms/jameelkhushkhati-ttf" type="text/css"/>
  <style type="text/css">
    .page-break {
      display: block;
      clear: both;
      page-break-after: always;
    }
    .container:after{
      content: "";
      display: block;
      clear: both;
    }
    table { page-break-inside:auto }
    tr    { page-break-inside:avoid; page-break-after:auto }
    thead { display:table-header-group }
    tfoot { display:table-footer-group }
  </style>
</head>
<body>
<div style="width:1400px;padding:10px;position:relative;font-family:Lato,sans-serif">
  <div class="float-container" style="margin-top: 10px;">
    <div style="width:100%;float:left;">
      <% if @show_salary == true %>
        <% departments = @employees.includes(:department).order('departments.name ASC').collect(&:department).uniq - [nil] %>
        <div style="text-align:right;font-size:10px">
          <%= "Extraction Date - #{DateTime.now.strftime("%B %d, %Y %I:%M %P")} "%>
        </div>
        <% if grade_params.present? %>
          <div style="text-align:right;font-size:10px">
            Report For: <%= grade_name(grade_params) %>
          </div>
        <% end %>
        <div style="text-align:right;font-size:10px">
          <%= "Page - 1 "%>
        </div>
        <% if not (@company.avatar_file_name.nil? or @company.avatar_file_name.blank?) %>
          <img src=<%= @company.avatar.url %> style="width:200px;height:75px;position:absolute">
          <h1 style="text-align:left;text-transform:uppercase;font-size:15px;font-weight:300;margin-bottom:0px;"><%= @company.name %></h1>
        <% end %>
        <div style="height:60px;margin-top:40px;">
          <h1 style="text-align:center;text-transform:uppercase;font-size:14px;font-weight:300;margin-bottom:0px;">Monthly Over Time Summary (<%= params[:payment_method] %>)</h1>
          <h1 style="text-align:center;text-transform:uppercase;font-size:14px;font-weight:300;margin-bottom:0px;">Report Type: Over Strength</h1>
          <h2 style="text-align:center;text-transform:uppercase;font-size:12px;font-weight:300;margin-bottom:0px;">Date Range: From: <%= params[:start_date].to_date %> To: <%= params[:end_date].to_date %> Mill: <%= @company.name %></h2>
        </div>
        <br>
        <br>
        <table style="border-collapse:collapse;width:100%;table-layout:fixed;">
          <thead style="text-align:center;font-size: 10px;">
          <tr style="background-color:#0454A9;color:#fff;page-break-inside: avoid;">
            <th style="text-align:center;text-transform:uppercase;font-weight: 300;font-size: 12px;padding:5px;" height="30">Department</th>
            <th style="text-align:center;text-transform:uppercase;font-weight: 300;font-size: 12px;padding:5px;" height="30">Sub Department</th>
            <th style="text-align:center;text-transform:uppercase;font-weight: 300;font-size: 12px;padding:5px;" height="30">Employees</th>
            <th style="text-align:center;text-transform:uppercase;font-weight: 300;font-size: 12px;padding:5px;" height="30">Gross Rate</th>
            <th style="text-align:center;text-transform:uppercase;font-weight: 300;font-size: 12px;padding:5px;" height="30">Hours</th>
            <th style="text-align:center;text-transform:uppercase;font-weight: 300;font-size: 12px;padding:5px;" height="30">Worked Days</th>
            <th style="text-align:center;text-transform:uppercase;font-weight: 300;font-size: 12px;padding:5px;" height="30">Payable Amount</th>
          </tr>
          </thead>
        </table>
        <table style="border-collapse:collapse;width:100%;table-layout:fixed;">
          <tbody>
          <% grand_gross_rate = 0 %>
          <% grand_overtime_hours = 0 %>
          <% grand_worked_days = 0 %>
          <% grand_payable_amount = 0 %>
          <% grand_total_employees = 0 %>
          <% departments.each do |department| %>
            <% sub_departments = @employees.includes(:sub_department).where(department_id: department.id).order('sub_departments.name ASC').collect(&:sub_department).uniq - [nil] %>
            <% sub_department_count = 0 %>
            <% sub_departments.each do |sub_department| %>
              <% sub_department_overtime = 0 %>
              <% sub_department_total_employees = 0 %>
              <% sub_department_gross = 0 %>
              <% sub_department_hours = 0 %>
              <% sub_department_worked_days = 0 %>
              <% sub_department_overtime_hours = 0 %>
              <% sub_department_overtime_amount = 0 %>
              <% @employees.active.where(department_id: department.id, sub_department_id: sub_department.id).each do |employee| %>
                <% overtime_hours = 0 %>
                <% employee_attendances = @employee_attendances.where(:employee_id => employee.id).where("attendance_date >= ? and attendance_date <= ?", params[:start_date].to_date, params[:end_date].to_date).order('attendance_date ASC') %>
                <% employee_attendances.each do |employee_attendance| %>
                  <% if params[:overtime_restriction] == "all" %>
                    <% overtime_hours = overtime_hours + (employee_attendance.approved_overtime_hours) %>
                    <% sub_department_overtime_amount = sub_department_overtime_amount + ((employee.gross_salary/26)/8) * 2 * (employee_attendance.approved_overtime_hours) %>
                  <% elsif params[:overtime_restriction] == "lesser" %>
                    <% if employee_attendance.approved_overtime_hours <= PayInvoice::OVERTIME_CHECK_VALUE %>
                      <% overtime_hours = overtime_hours + (employee_attendance.approved_overtime_hours) %>
                      <% sub_department_overtime_amount = sub_department_overtime_amount + ((employee.gross_salary/26)/8) * 2 * (employee_attendance.approved_overtime_hours) %>
                    <% end %>
                  <% elsif params[:overtime_restriction] == "greater" %>
                    <% if employee_attendance.approved_overtime_hours > PayInvoice::OVERTIME_CHECK_VALUE %>
                      <% overtime_hours = overtime_hours + (employee_attendance.approved_overtime_hours) %>
                      <% sub_department_overtime_amount = sub_department_overtime_amount + ((employee.gross_salary/26)/8) * 2 * (employee_attendance.approved_overtime_hours) %>
                    <% end %>
                  <% end %>
                <% end %>
                <% sub_department_overtime_hours += overtime_hours %>
                <% if overtime_hours > 0 %>
                  <% sub_department_total_employees += 1 %>
                  <% sub_department_gross += employee.gross_salary %>
                <% end %>
              <% end %>
              <% if sub_department_overtime_hours > 0 %>
                <% sub_department_overtime += sub_department_overtime_amount %>
                <% sub_department_hours += sub_department_overtime_hours %>
                <% sub_department_worked_days += (sub_department_overtime_hours/8) %>
                <tr style="border:2px solid #ECECEC;border-top:0px;page-break-inside: avoid;">
                  <% if sub_department_count == 0 %>
                    <td style="text-align:center;padding: 5px 10px 5px 0px;" height="30"><%= department.name %></td>
                  <% else %>
                    <td style="text-align:center;padding: 5px 10px 5px 0px;" height="30"></td>
                  <% end %>
                  <td style="text-align:center;padding: 5px 10px 5px 0px;" height="30"><%= sub_department.name %></td>
                  <td style="text-align:center;padding: 5px 10px 5px 0px;" height="30"><%= sub_department_total_employees %></td>
                  <td style="text-align:center;padding: 5px 10px 5px 0px;" height="30"><%= number_with_delimiter(sub_department_gross.round) %></td>
                  <td style="text-align:center;padding: 5px 10px 5px 0px;" height="30"><%= sub_department_hours.round %></td>
                  <td style="text-align:center;padding: 5px 10px 5px 0px;" height="30"><%= sub_department_worked_days.round(1) %></td>
                  <td style="text-align:center;padding: 5px 10px 5px 0px;" height="30"><%= number_with_delimiter(sub_department_overtime.round) %></td>
                </tr>
                <% grand_gross_rate += sub_department_gross %>
                <% grand_overtime_hours += sub_department_hours %>
                <% grand_worked_days += sub_department_worked_days %>
                <% grand_payable_amount += sub_department_overtime %>
                <% grand_total_employees += sub_department_total_employees %>
                <% sub_department_count += 1 %>
              <% end %>
            <% end %>
          <% end %>
          <tr style="background-color:#0454A9;color:#fff;page-break-inside: avoid;">
            <td style="text-align:center;text-transform:uppercase;font-weight: 300;font-size: 12px;padding:5px;" height="30">Grand Total</td>
            <td style="text-align:center;text-transform:uppercase;font-weight: 300;font-size: 12px;padding:5px;" height="30"></td>
            <td style="text-align:center;text-transform:uppercase;font-weight: 300;font-size: 12px;padding:5px;" height="30"><%= number_with_delimiter(grand_total_employees.round) %></td>
            <td style="text-align:center;text-transform:uppercase;font-weight: 300;font-size: 12px;padding:5px;" height="30"><%= number_with_delimiter(grand_gross_rate.round) %></td>
            <td style="text-align:center;text-transform:uppercase;font-weight: 300;font-size: 12px;padding:5px;" height="30"><%= number_with_delimiter(grand_overtime_hours.round) %></td>
            <td style="text-align:center;text-transform:uppercase;font-weight: 300;font-size: 12px;padding:5px;" height="30"><%= number_with_delimiter(grand_worked_days.round(1)) %></td>
            <td style="text-align:center;text-transform:uppercase;font-weight: 300;font-size: 12px;padding:5px;" height="30"><%= number_with_delimiter(grand_payable_amount.round) %></td>
          </tr>
          </tbody>
        </table>
      <% else %>
        <div style="width:1400px;padding:20px;box-sizing:border-box;position:relative;font-family:Lato,sans-serif">
          Access Denied
        </div>
      <% end %>
    </div>
  </div>
  <br/>
</div>

</body>
</html>
<style type="text/css">
  .page-break { page-break-after:always; }
  .message{
    border: 2px solid #ececec;
    padding: 10px;
    font-size: 12px;
  }
  .message p{
    margin: 0;
  }
  @font-face{
    font-family: Lato;
    -fs-pdf-font-embed: embed;
    -fs-pdf-font-encoding: Identity-H;
  }
  body{
    margin:0;
  }
  .float-container:after{
    content: "";
    display: block;
    clear: both;
  }
</style>
<!DOCTYPE html>
<html>
<head>
  <title>Objective Setting Report</title>
  <style>
      table, th, td {
          border: 1px solid black;
          border-collapse: collapse;
      }
      td{
          font-size: 18px;
          padding: 5px;
      }
  </style>
</head>
<body>
<div>
  <table width="100%">
    <tr style="text-align: center; font-size: 20px">
      <th>Objective Setting - Appraisal Period (<%= @fiscal_year_data.first.name %>)</th>
    </tr>
    <tr style="text-align: center;">
      <td>Objectives for next appraisal period, to be agreed between the employee and the Line Manager.<br>Total weightage: 100% (Between <%= @objective_setting.starting_weight %> to <%= @objective_setting.ending_weight %>)</td>
    </tr>
  </table>
</div><br>
<div>
  <table width="100%">
    <tr>
      <td style="width: 20%"><b>Employee Name:</b></td>
      <td style="width: 30%"><%= @employee_data.first.first_name %> <%= @employee_data.first.last_name %></td>
      <td style="width: 25%"><b>Emp. No:</b></td>
      <td style="width: 25%"><%= @employee_data.first.personal_number %></td>
    </tr>
    <tr>
      <td style="width: 20%"><b>Position Title:</b></td>
      <td style="width: 30%"><%= @designation.first.name %></td>
      <td style="width: 25%"><b>Grade:</b></td>
      <td style="width: 25%"><%= @grade.first.name %></td>
    </tr>
    <tr>
      <td style="width: 20%"><b>Department:</b></td>
      <td style="width: 30%"><%= @department.first.name %></td>
      <td style="width: 25%"><b>Date of Joining:</b></td>
      <td style="width: 25%"><%= @employee_data.first.joining_date.strftime("%B %d, %Y") %></td>
    </tr>
    <tr>
      <td style="width: 20%"><b>Line Manager (Name):</b></td>
      <td style="width: 30%"><%= @line_manager.first.first_name %> <%= @line_manager.first.last_name %></td>
      <td style="width: 25%"><b>Line Manager (Emp. No):</b></td>
      <td style="width: 25%"><%= @line_manager.first.id %></td>
    </tr>
  </table>
</div><br>
<div>
  <table width="100%">
    <tr style="text-align: center;">
      <td style="width: 5%"><b>Sr. No.</b></td>
      <td style="width: 30%"><b>Goals and Objectives</b></td>
      <td style="width: 35%"><b>KPI's</b></td>
      <td style="width: 10%"><b>Weight %</b></td>
      <td style="width: 20%"><b>Due Date</b></td>
    </tr>
  </table>
</div><br>
<div>
  <table width="100%">
    <% count = 1 %>
    <% @task_data.each do |goals| %>
      <tr>
        <td style="width: 5%; text-align: center;" rowspan="<%= goals.first.sub_tasks.count + 1 %>"><b><%= count %></b></td>
        <td style="width: 30%" rowspan="<%= goals.first.sub_tasks.count + 1 %>"><%= goals.first.goal %></td>
        <td style="width: 35%; text-align: center;"><b>KPI's</b></td>
        <td style="width: 10%; text-align: center;" rowspan="<%= goals.first.sub_tasks.count + 1 %>"><%= goals.first.weight %></td>
        <td style="width: 20%; text-align: center;" rowspan="<%= goals.first.sub_tasks.count + 1 %>"><%= Date.parse(goals.first.due_date).strftime("%B %d, %Y") %></td>
      </tr>
      <% goals.first.sub_tasks.each do |kpis| %>
        <tr>
          <% @task_ids.each do |id| %>
            <% if (kpis.task_id == id.to_i) %>
              <td style="width: 25%"><%= kpis.kpi %></td>
            <% end %>
          <% end %>
        </tr>
      <% end %>
      <% count = count + 1 %>
    <% end %>
    <tr>
      <td style="width: 5%; text-align: center;"></td>
      <td colspan="2"><b>Total Weightage:</b></td>
      <td style="text-align: center; width: 10%"><b><%= @total %> %</b></td>
      <td style="width: 20%; text-align: center;"></td>
    </tr>
  </table>
</div><br>
</body>
</html>
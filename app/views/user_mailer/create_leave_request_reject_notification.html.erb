<html>

<head>
  <meta content='text/html; charset=UTF-8' http-equiv='Content-Type' />
  <style>
      table, tr, td, th{
          border-collapse: collapse;
          border: 1px solid black;
          padding: 20px;
          text-align: center;
      }
  </style>
</head>

<body>
<table width="100%">
  <tr>
    <th>Employee Code</th>
    <th>Employee Name</th>
    <th>Department</th>
    <th>Date</th>
    <th>Status</th>
  </tr>
  <tr>
    <td><%= @approval_request.requestable.employee.employee_code %></td>
    <td><%= @approval_request.requestable.employee.full_name %></td>
    <td><%= @approval_request.requestable.employee.department_name %></td>
    <td><%= @approval_request.created_at.to_date.strftime("%d-%B-%Y") %></td>
    <td style="font-size: 18px; text-decoration: none; background-color: #d9534f; color: white; padding: 10px">Rejected</td>
  </tr>
</table>
</body>

</html>

<html>
  <head>
    <meta content='text/html; charset=UTF-8' http-equiv='Content-Type' />
  </head>
  <body>

    <!-- <p>Your Account in Re-Generated</p>
    <p>New Password is <%= @custom_password %></p> -->

    <% if Rails.env.production? %>
    	<% link = "oneamericaadmin.alchemative.net/#/core/reset_pass/" %>
    <% else %>
    	<% link = "http://localhost:9030/#/core/reset_pass/" %>
    <% end %>

    <p>
      To reset your password click the URL below.
    </p>
    <a href=<%= "#{link}#{@user.reset_password_token}" %>>
			Reset Password
    </a>
    <p>
			If you did not request your password to be reset please ignore this email and your password will stay as it is.
    </p>

  </body>
</html>
